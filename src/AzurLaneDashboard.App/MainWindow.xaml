<Window x:Class="AzurLaneDashboard.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:views="clr-namespace:AzurLaneDashboard.App.Views"
        mc:Ignorable="d"
        Title="Azur Lane Dashboard"
        Width="1360"
        Height="860"
        MinWidth="1080"
        MinHeight="680"
        WindowStyle="None"
        ResizeMode="CanResize"
        Icon="Assets/app.ico"
        Background="{DynamicResource BgBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="{DynamicResource AppFontFamily}"
        FontSize="13"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding ReloadCommand}" />
        <KeyBinding Key="Escape" Command="{Binding CloseShipDetailCommand}" />
        <KeyBinding Key="D1" Modifiers="Control" Command="{Binding NavigateCommand}" CommandParameter="0" />
        <KeyBinding Key="D2" Modifiers="Control" Command="{Binding NavigateCommand}" CommandParameter="1" />
    </Window.InputBindings>
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Grid Background="{DynamicResource BgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <views:TitleBarView Grid.Row="0" />

        <views:DashboardShellView x:Name="DashboardShell" Grid.Row="1" />

        <Grid x:Name="ShipDetailOverlay"
              Grid.Row="0"
              Grid.RowSpan="2"
              Opacity="0"
              IsHitTestVisible="False">
            <Button Command="{Binding CloseShipDetailCommand}"
                    Focusable="False"
                    BorderThickness="0"
                    Background="{DynamicResource OverlayBrush}"
                    Padding="0"
                    Cursor="Arrow"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    AutomationProperties.Name="상세 닫기">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" />
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <Grid x:Name="ShipDetailPanel"
                  Width="720"
                  Margin="0,40,0,0"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Stretch"
                  RenderTransformOrigin="1,0.5">
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="ShipDetailPanelTransform" X="760" />
                </Grid.RenderTransform>
                <!-- Shadow lives on an empty sibling so the scrolling content is not re-rendered through the effect. -->
                <Border Background="{DynamicResource SurfaceBrush}" IsHitTestVisible="False">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="32" ShadowDepth="0" Opacity="0.35" Color="#000000" />
                    </Border.Effect>
                </Border>
                <views:ShipDetailPanelView />
            </Grid>
        </Grid>
    </Grid>
</Window>
