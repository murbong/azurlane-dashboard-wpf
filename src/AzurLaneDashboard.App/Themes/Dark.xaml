<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Surfaces: shell is darkest, content background, then cards and raised elements. -->
    <SolidColorBrush x:Key="BgBrush" Color="#121418" />
    <SolidColorBrush x:Key="ShellBrush" Color="#0E1013" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#191C22" />
    <SolidColorBrush x:Key="Surface2Brush" Color="#22262E" />
    <SolidColorBrush x:Key="InputBrush" Color="#14171C" />
    <SolidColorBrush x:Key="LineBrush" Color="#2B3039" />
    <SolidColorBrush x:Key="SubtleLineBrush" Color="#22262D" />

    <!-- Text -->
    <SolidColorBrush x:Key="TextBrush" Color="#E8EBF0" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#B5BDC9" />
    <SolidColorBrush x:Key="MutedBrush" Color="#8C95A3" />

    <!-- Accent: interaction, focus and selection only -->
    <SolidColorBrush x:Key="AccentBrush" Color="#6AA4FF" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#8DBAFF" />
    <SolidColorBrush x:Key="AccentSubtleBrush" Color="#1B2A42" />
    <SolidColorBrush x:Key="PrimaryBrush" Color="#3B7BEA" />
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#4C89F2" />
    <SolidColorBrush x:Key="PrimaryPressedBrush" Color="#2F69CF" />
    <SolidColorBrush x:Key="OnPrimaryBrush" Color="#FFFFFF" />

    <!-- Semantic states -->
    <SolidColorBrush x:Key="GoodBrush" Color="#5CCB94" />
    <SolidColorBrush x:Key="GoodSubtleBrush" Color="#152A21" />
    <SolidColorBrush x:Key="WarnBrush" Color="#E9AE52" />
    <SolidColorBrush x:Key="WarnSubtleBrush" Color="#2E2516" />
    <SolidColorBrush x:Key="DangerBrush" Color="#F27C88" />
    <SolidColorBrush x:Key="DangerSubtleBrush" Color="#311B20" />
    <SolidColorBrush x:Key="ProposedShipNameBrush" Color="#FF8EC7" />

    <!-- Community rating chips -->
    <!-- Community rating badges: fill for SS/EX, gold text on the subtle high-tier background -->
    <SolidColorBrush x:Key="GoodLineBrush" Color="#2C5A43" />
    <SolidColorBrush x:Key="RatingTopFillBrush" Color="#E9C46A" />
    <SolidColorBrush x:Key="RatingTopTextBrush" Color="#241A05" />
    <SolidColorBrush x:Key="RatingHighTextBrush" Color="#E9C46A" />
    <SolidColorBrush x:Key="CommunityHighBrush" Color="#2C2414" />
    <SolidColorBrush x:Key="CommunityHighBorderBrush" Color="#A57A2A" />
    <SolidColorBrush x:Key="CommunityMidBrush" Color="#132739" />
    <SolidColorBrush x:Key="CommunityMidBorderBrush" Color="#3F8CC8" />
    <SolidColorBrush x:Key="CommunityLowBrush" Color="#262124" />
    <SolidColorBrush x:Key="CommunityLowBorderBrush" Color="#6C5A5E" />

    <!-- Tables and interaction states -->
    <SolidColorBrush x:Key="DataGridHeaderBrush" Color="#1D2026" />
    <SolidColorBrush x:Key="DataGridAltBrush" Color="#1B1E24" />
    <SolidColorBrush x:Key="DataGridGridBrush" Color="#252931" />
    <SolidColorBrush x:Key="SelectionBrush" Color="#1E3050" />
    <SolidColorBrush x:Key="ControlHoverBrush" Color="#232731" />
    <SolidColorBrush x:Key="ControlPressedBrush" Color="#2A2F3A" />
    <SolidColorBrush x:Key="RarityBadgeTextBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="OverlayBrush" Color="#A6000000" />
</ResourceDictionary>
