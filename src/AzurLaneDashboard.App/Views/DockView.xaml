<UserControl x:Class="AzurLaneDashboard.App.Views.DockView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:AzurLaneDashboard.App.Views">
    <Grid>
        <DockPanel>
            <TextBlock DockPanel.Dock="Top"
                       Text="{Binding DockUsageText}"
                       Foreground="{DynamicResource MutedBrush}"
                       Margin="0,0,0,8" />
            <TabControl>
                <views:TabTools.Content>
                    <views:InventorySearchBar Visibility="{Binding IsInventorySearchVisible, Converter={StaticResource BoolToVisibilityConverter}}" />
                </views:TabTools.Content>
                <TabItem Header="보유 함선">
                    <DataGrid x:Name="ShipsDataGrid"
                              Style="{StaticResource MainListDataGrid}"
                              ItemsSource="{Binding ShipsView}"
                              SelectedItem="{Binding SelectedShip}"
                              Sorting="ShipsDataGrid_Sorting"
                              FrozenColumnCount="1"
                              RowHeight="54">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="함선" Width="210" MinWidth="180"
                                                    SortMemberPath="DisplayName"
                                                    CellStyle="{StaticResource FullHeightDataGridCell}"
                                                    CellTemplate="{StaticResource ShipIdentityCellTemplate}" />
                            <DataGridTextColumn Header="Lv" Binding="{Binding Level}" Width="58" />
                            <DataGridTextColumn Header="기분" Binding="{Binding MoodText}" Width="64" />
                            <DataGridTemplateColumn Header="등급" Width="82"
                                                    SortMemberPath="Rarity"
                                                    CellStyle="{StaticResource CenteredDataGridCell}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource RarityBadge}"
                                                Background="{Binding Rarity, Converter={StaticResource RarityBrushConverter}}">
                                            <TextBlock Text="{Binding Rarity}"
                                                       Foreground="{DynamicResource RarityBadgeTextBrush}"
                                                       HorizontalAlignment="Center" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="장비" Width="300"
                                                    CellStyle="{StaticResource CenteredDataGridCell}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ItemsControl ItemsSource="{Binding LoadoutSlots}"
                                                      VerticalAlignment="Center">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Width="44"
                                                            Height="44"
                                                            Background="{Binding Rarity, Converter={StaticResource RarityBrushConverter}, ConverterParameter=cell}"
                                                            BorderBrush="{Binding Rarity, Converter={StaticResource RarityBrushConverter}, ConverterParameter=bar}"
                                                            BorderThickness="3,0,0,0"
                                                            CornerRadius="7"
                                                            Padding="3"
                                                            Margin="0,0,6,0"
                                                            ToolTip="{Binding ToolTipText}">
                                                        <Grid>
                                                            <Image
                                                                Source="{Binding DisplayIconUrl, Converter={StaticResource AssetImageConverter}}"
                                                                Stretch="Uniform" />
                                                            <Border Width="18"
                                                                    Height="18"
                                                                    HorizontalAlignment="Left"
                                                                    VerticalAlignment="Bottom"
                                                                    Background="{DynamicResource SurfaceBrush}"
                                                                    BorderBrush="{DynamicResource LineBrush}"
                                                                    BorderThickness="1"
                                                                    CornerRadius="4"
                                                                    Visibility="{Binding ShowSkinThumbnail, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                <Image
                                                                    Source="{Binding SkinIconUrl, Converter={StaticResource AssetImageConverter}}"
                                                                    Stretch="UniformToFill" />
                                                            </Border>
                                                            <TextBlock Text="{Binding SlotTag}"
                                                                       HorizontalAlignment="Left"
                                                                       VerticalAlignment="Top"
                                                                       FontSize="10"
                                                                       FontWeight="Bold"
                                                                       Foreground="{DynamicResource TextBrush}" />
                                                            <TextBlock Text="{Binding EnhanceText}"
                                                                       HorizontalAlignment="Right"
                                                                       VerticalAlignment="Bottom"
                                                                       FontSize="10"
                                                                       FontWeight="Bold"
                                                                       Foreground="{DynamicResource TextBrush}" />
                                                            <TextBlock Text="{Binding SkinTag}"
                                                                       HorizontalAlignment="Right"
                                                                       VerticalAlignment="Top"
                                                                       FontSize="10"
                                                                       FontWeight="Bold"
                                                                       Foreground="{DynamicResource TextBrush}" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="커뮤니티" Width="*" MinWidth="200"
                                                    SortMemberPath="CommunityBestScore"
                                                    CellStyle="{StaticResource CenteredDataGridCell}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ItemsControl ItemsSource="{Binding CommunityRatingPreview}"
                                                      ToolTip="{Binding CommunitySummary}" ClipToBounds="True"
                                                      VerticalAlignment="Center">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource CommunityRatingChip}"
                                                            MinHeight="20"
                                                            Padding="6,1"
                                                            Margin="0,0,4,4">
                                                        <TextBlock Text="{Binding Label}"
                                                                   FontSize="11"
                                                                   FontWeight="SemiBold" />
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="추천" Binding="{Binding RecommendationSummary}" Width="150"
                                                ElementStyle="{StaticResource CenteredDataGridText}" />
                            <DataGridTemplateColumn Header="상태" Width="140"
                                                    CellStyle="{StaticResource CenteredDataGridCell}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ItemsControl ItemsSource="{Binding StatusBadges}"
                                                      VerticalAlignment="Center">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource StatusBadgeChip}">
                                                        <TextBlock Text="{Binding Label}"
                                                                   FontSize="11"
                                                                   FontWeight="SemiBold" />
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>

                <TabItem Header="정리 후보">
                    <DataGrid Style="{StaticResource MainListDataGrid}"
                              ItemsSource="{Binding CleanupCandidates}"
                              RowHeight="42">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="함선 ID" Binding="{Binding TemplateId}" Width="110" />
                            <DataGridTextColumn Header="함선" Binding="{Binding Name}" Width="2*" />
                            <DataGridTextColumn Header="수량" Binding="{Binding Count}" Width="70" />
                            <DataGridTextColumn Header="이유" Binding="{Binding Reason}" Width="3*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
            </TabControl>
        </DockPanel>
    </Grid>
</UserControl>
