<UserControl x:Class="AzurLaneDashboard.App.Views.MetaBossPlanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:AzurLaneDashboard.App.Views"
             Foreground="{DynamicResource TextBrush}"
             FontSize="13"
             SizeChanged="OnSizeChanged">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="FleetPlannerShared.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <DataTemplate x:Key="BossSelectedTemplate">
                <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                    <Run Text="{Binding Name, Mode=OneWay}" FontWeight="Bold" />
                    <Run Text="{Binding KindText, Mode=OneWay}" FontSize="11" Foreground="{DynamicResource MutedBrush}" />
                </TextBlock>
            </DataTemplate>

            <!-- Open list: group header on the first boss of each group, then armor, hull and guide status. -->
            <DataTemplate x:Key="BossChoiceTemplate">
                <StackPanel MinWidth="440">
                    <TextBlock Text="{Binding GroupLabel}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource MutedBrush}"
                               Margin="0,4,0,4" Visibility="{Binding StartsGroup, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="72" />
                            <ColumnDefinition Width="44" />
                            <ColumnDefinition Width="74" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                            <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" />
                            <Run Text="{Binding MarkText, Mode=OneWay}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                        </TextBlock>
                        <TextBlock Grid.Column="1" Text="{Binding ArmorText}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="{Binding HullText}" FontSize="11" Foreground="{DynamicResource MutedBrush}"
                                   VerticalAlignment="Center" />
                        <TextBlock x:Name="Guide" Grid.Column="3" Text="{Binding GuideText}" FontSize="11" TextAlignment="Right"
                                   Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding HasGuide}" Value="True">
                        <Setter TargetName="Guide" Property="Foreground" Value="{DynamicResource GoodBrush}" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>

            <views:ComboBoxChoiceTemplateSelector x:Key="BossTemplateSelector"
                                                  SelectedTemplate="{StaticResource BossSelectedTemplate}"
                                                  DropDownTemplate="{StaticResource BossChoiceTemplate}" />

            <DataTemplate x:Key="MechanicTemplate">
                <StackPanel Margin="0,0,16,0">
                    <TextBlock Text="{Binding Title}" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Text}" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"
                               Margin="0,2,0,0" />
                    <TextBlock Text="{Binding Response, StringFormat=→ {0}}" FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap" Margin="0,2,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Response}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </DataTemplate>

            <!-- A fleet tile is a button: choosing it opens that ship's gear on the right. -->
            <DataTemplate x:Key="MetaSlotTemplate">
                <Button x:Name="Tile" Margin="0,0,8,0" Cursor="Hand" ToolTip="{Binding ToolTipText}" AutomationProperties.Name="{Binding Name, StringFormat={}{0} 장비 추천 보기}"
                        Command="{Binding DataContext.SelectMetaShipCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding}" FocusVisualStyle="{x:Null}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Face" Padding="4" CornerRadius="8" Background="Transparent" BorderBrush="Transparent"
                                    BorderThickness="1">
                                <ContentPresenter />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Face" Property="Background" Value="{DynamicResource ControlHoverBrush}" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Face" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                </Trigger>
                                <DataTrigger Value="True">
                                    <DataTrigger.Binding>
                                        <MultiBinding Converter="{StaticResource StringEqualsConverter}">
                                            <Binding Path="ShipUid" />
                                            <Binding Path="DataContext.SelectedMetaShipUid" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                        </MultiBinding>
                                    </DataTrigger.Binding>
                                    <Setter TargetName="Face" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                    <Setter TargetName="Face" Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
                                </DataTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <StackPanel>
                        <Grid Height="76">
                            <Border Style="{StaticResource Portrait}">
                                <Image Source="{Binding IconUrl, Converter={StaticResource AssetImageConverter}}" Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                            </Border>
                            <Border Style="{StaticResource RatingCorner}">
                                <TextBlock Text="{Binding Rating}" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"
                                           HorizontalAlignment="Center" />
                            </Border>
                            <Border Height="18" Padding="5,0" CornerRadius="0,6,0,6" HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Background="{DynamicResource ShellBrush}">
                                <TextBlock x:Name="Source" Text="{Binding SourceText}" FontWeight="Bold" FontSize="11"
                                           Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                        <TextBlock Text="{Binding Name}" Margin="0,6,0,0" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding SubText}" FontSize="11" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="Role" Text="{Binding RoleText}" FontSize="11" Foreground="{DynamicResource MutedBrush}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Button>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsAlternative}" Value="True">
                        <Setter TargetName="Source" Property="Foreground" Value="{DynamicResource WarnBrush}" />
                        <Setter TargetName="Role" Property="Foreground" Value="{DynamicResource WarnBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsAuto}" Value="True">
                        <Setter TargetName="Source" Property="Foreground" Value="{DynamicResource MutedBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsFlagship}" Value="True">
                        <Setter TargetName="Role" Property="Foreground" Value="{DynamicResource RatingHighTextBrush}" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>

            <!-- Fleet overlap chip: amber while ships differ, green once all six match. -->
            <Style x:Key="OverlapChip" TargetType="Border" BasedOn="{StaticResource WarnChip}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsMetaOverlapFull}" Value="True">
                        <Setter Property="Background" Value="{DynamicResource GoodSubtleBrush}" />
                        <Setter Property="TextElement.Foreground" Value="{DynamicResource GoodBrush}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- Result chip: boss killed green, HP left amber, mop-up fights muted. -->
            <Style x:Key="FightResultChip" TargetType="Border" BasedOn="{StaticResource PlannerChip}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding ResultKind}" Value="good">
                        <Setter Property="Background" Value="{DynamicResource GoodSubtleBrush}" />
                        <Setter Property="TextElement.Foreground" Value="{DynamicResource GoodBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding ResultKind}" Value="warn">
                        <Setter Property="Background" Value="{DynamicResource WarnSubtleBrush}" />
                        <Setter Property="TextElement.Foreground" Value="{DynamicResource WarnBrush}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- A thin track with a fill scaled to the value, so the bar needs no converter. -->
            <Style x:Key="BarTrack" TargetType="Border">
                <Setter Property="Height" Value="6" />
                <Setter Property="CornerRadius" Value="3" />
                <Setter Property="Background" Value="{DynamicResource InputBrush}" />
            </Style>

            <Style x:Key="BarFill" TargetType="Border">
                <Setter Property="CornerRadius" Value="3" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="RenderTransformOrigin" Value="0,0.5" />
                <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            </Style>

            <!-- One recorded fight in the list; choosing it opens its detail. -->
            <DataTemplate x:Key="FightRowTemplate">
                <Button Margin="0,0,0,4" Cursor="Hand" FocusVisualStyle="{x:Null}" HorizontalContentAlignment="Stretch"
                        AutomationProperties.Name="{Binding WhenText, StringFormat={}{0} META전 보기}"
                        Command="{Binding DataContext.SelectMetaFightCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Face" Padding="12,9" CornerRadius="8" Background="Transparent" BorderBrush="Transparent"
                                    BorderThickness="1">
                                <ContentPresenter />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Face" Property="Background" Value="{DynamicResource ControlHoverBrush}" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Face" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                </Trigger>
                                <DataTrigger Value="True">
                                    <DataTrigger.Binding>
                                        <MultiBinding Converter="{StaticResource StringEqualsConverter}">
                                            <Binding Path="Key" />
                                            <Binding Path="DataContext.SelectedMetaFightKey" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                        </MultiBinding>
                                    </DataTrigger.Binding>
                                    <Setter TargetName="Face" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                    <Setter TargetName="Face" Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
                                </DataTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <StackPanel>
                        <DockPanel>
                            <Border DockPanel.Dock="Right" Style="{StaticResource FightResultChip}">
                                <TextBlock Text="{Binding ResultText}" />
                            </Border>
                            <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                <Run Text="{Binding WhenText, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" />
                                <Run Text="{Binding OwnerText, Mode=OneWay}" FontSize="11" Foreground="{DynamicResource MutedBrush}" />
                            </TextBlock>
                        </DockPanel>
                        <TextBlock Margin="0,4,0,0" TextTrimming="CharacterEllipsis">
                            <Run Text="{Binding DamageText, Mode=OneWay}" FontSize="14" FontWeight="Bold" />
                            <Run Text="{Binding PercentText, Mode=OneWay}" FontSize="11" Foreground="{DynamicResource MutedBrush}" />
                        </TextBlock>
                        <Border Style="{StaticResource BarTrack}" Height="4" Margin="0,6,0,0">
                            <Border x:Name="Fill" Style="{StaticResource BarFill}">
                                <Border.RenderTransform>
                                    <ScaleTransform ScaleX="{Binding DamageFraction}" />
                                </Border.RenderTransform>
                            </Border>
                        </Border>
                    </StackPanel>
                </Button>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsFullFight}" Value="False">
                        <Setter TargetName="Fill" Property="Background" Value="{DynamicResource MutedBrush}" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>

            <!-- A finding: marker in the kind's colour, then a bold claim and the numbers behind it. -->
            <DataTemplate x:Key="FindingTemplate">
                <DockPanel Margin="0,0,0,10">
                    <Border x:Name="Badge" DockPanel.Dock="Left" Width="20" Height="20" CornerRadius="10" Margin="0,0,10,0"
                            VerticalAlignment="Top" Background="{DynamicResource AccentSubtleBrush}">
                        <TextBlock x:Name="Mark" Text="{Binding Mark}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}" />
                    </Border>
                    <StackPanel>
                        <TextBlock Text="{Binding Title}" FontWeight="Bold" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Text}" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                </DockPanel>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding Kind}" Value="good">
                        <Setter TargetName="Badge" Property="Background" Value="{DynamicResource GoodSubtleBrush}" />
                        <Setter TargetName="Mark" Property="Foreground" Value="{DynamicResource GoodBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Kind}" Value="warn">
                        <Setter TargetName="Badge" Property="Background" Value="{DynamicResource WarnSubtleBrush}" />
                        <Setter TargetName="Mark" Property="Foreground" Value="{DynamicResource WarnBrush}" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>

            <!-- One ship's line: who, how much of the damage, and how it came out. -->
            <DataTemplate x:Key="FightShipTemplate">
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Portrait}" Width="40" Height="40" VerticalAlignment="Top" BorderThickness="0,0,0,2">
                        <Image Source="{Binding IconUrl, Converter={StaticResource AssetImageConverter}}" Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border>
                    <StackPanel Grid.Column="2">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="8,0,0,0"
                                       VerticalAlignment="Bottom">
                                <Run Text="{Binding DamageText, Mode=OneWay}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" />
                                <Run Text="{Binding ShareText, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock TextTrimming="CharacterEllipsis" VerticalAlignment="Bottom">
                                <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" />
                                <Run Text="{Binding SubText, Mode=OneWay}" FontSize="11" Foreground="{DynamicResource MutedBrush}" />
                            </TextBlock>
                        </DockPanel>
                        <Border Style="{StaticResource BarTrack}" Margin="0,5,0,0">
                            <Border Style="{StaticResource BarFill}">
                                <Border.RenderTransform>
                                    <ScaleTransform ScaleX="{Binding BarFraction}" />
                                </Border.RenderTransform>
                            </Border>
                        </Border>
                        <TextBlock FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis">
                            <Run Text="{Binding TakenText, Mode=OneWay}" />
                            <Run Text="·" />
                            <Run Text="{Binding MaxHitText, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Text="{Binding GearText}" FontSize="11" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding GearText}" Margin="0,2,0,0"
                                   Visibility="{Binding HasGear, Converter={StaticResource BoolToVisibilityConverter}}" />
                    </StackPanel>
                    <Border x:Name="Hp" Grid.Column="4" Style="{StaticResource PlannerChip}" MinWidth="64" VerticalAlignment="Top">
                        <TextBlock Text="{Binding HpText}" HorizontalAlignment="Center" />
                    </Border>
                </Grid>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding HpKind}" Value="sunk">
                        <Setter TargetName="Hp" Property="Background" Value="{DynamicResource DangerSubtleBrush}" />
                        <Setter TargetName="Hp" Property="TextElement.Foreground" Value="{DynamicResource DangerBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding HpKind}" Value="low">
                        <Setter TargetName="Hp" Property="Background" Value="{DynamicResource WarnSubtleBrush}" />
                        <Setter TargetName="Hp" Property="TextElement.Foreground" Value="{DynamicResource WarnBrush}" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel>
        <!-- Boss context: which boss, how it fights, and where the strategy comes from. -->
        <Border Style="{StaticResource SectionPanel}" Padding="16,12" Margin="0,0,0,16">
            <StackPanel>
                <WrapPanel>
                    <TextBlock Text="META 보스" Style="{StaticResource FactLabel}" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <ComboBox ItemsSource="{Binding BossChoices}" SelectedItem="{Binding SelectedBoss, Mode=TwoWay}"
                              ItemTemplateSelector="{StaticResource BossTemplateSelector}" MinWidth="240" MaxWidth="420"
                              VerticalAlignment="Center" MaxDropDownHeight="560" AutomationProperties.Name="META 보스" />
                    <Border Style="{StaticResource AccentChip}" Margin="10,0,0,0"
                            Visibility="{Binding MetaPlan.HasAvailabilityChip, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="{Binding MetaPlan.AvailabilityText}" />
                    </Border>
                    <TextBlock Text="상시 보스도 고를 수 있습니다" FontSize="12" Foreground="{DynamicResource MutedBrush}"
                               VerticalAlignment="Center" Margin="10,0,0,0" />
                </WrapPanel>
                <WrapPanel Margin="0,12,0,0">
                    <StackPanel Margin="0,0,24,0">
                        <TextBlock Text="장갑" Style="{StaticResource FactLabel}" />
                        <TextBlock Text="{Binding MetaPlan.ArmorText}" Style="{StaticResource FactValue}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,24,0">
                        <TextBlock Text="함종" Style="{StaticResource FactLabel}" />
                        <TextBlock Text="{Binding MetaPlan.HullText}" Style="{StaticResource FactValue}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,24,0">
                        <TextBlock Text="HP" Style="{StaticResource FactLabel}" />
                        <TextBlock Text="{Binding MetaPlan.HpText}" Style="{StaticResource FactValue}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,24,0">
                        <TextBlock Text="전투 시간" Style="{StaticResource FactLabel}" />
                        <TextBlock Text="{Binding MetaPlan.BattleTimeText}" Style="{StaticResource FactValue}" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="장비 순위 기준" Style="{StaticResource FactLabel}" />
                        <TextBlock Text="{Binding MetaPlan.GearBasisText}" Style="{StaticResource FactValue}" />
                    </StackPanel>
                </WrapPanel>
                <Border BorderBrush="{DynamicResource SubtleLineBrush}" BorderThickness="0,1,0,0" Margin="0,12,0,0" Padding="0,12,0,0">
                    <ItemsControl ItemsSource="{Binding MetaPlan.Mechanics}" ItemTemplate="{StaticResource MechanicTemplate}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </Border>
                <TextBlock Text="{Binding MetaPlan.SourceText}" FontSize="11" Foreground="{DynamicResource MutedBrush}"
                           TextTrimming="CharacterEllipsis" Margin="0,10,0,0" ToolTip="{Binding MetaPlan.Guide.Notes}" />
            </StackPanel>
        </Border>

        <Grid x:Name="Body">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="MainColumn" Width="3*" />
                <ColumnDefinition x:Name="GapColumn" Width="20" />
                <ColumnDefinition x:Name="SideColumn" Width="2*" MinWidth="360" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel x:Name="FleetSection">
                <TextBlock Margin="0,0,0,10" TextTrimming="CharacterEllipsis">
                    <Run Text="추천 편성" FontSize="16" FontWeight="Bold" />
                    <Run Text="공략 편성을 보유 함선으로 채움 · 없거나 Lv.120 전이면 공략 차선" FontSize="12"
                         Foreground="{DynamicResource MutedBrush}" />
                </TextBlock>
                <Border Style="{StaticResource SectionPanel}" Padding="18,14,10,16">
                    <StackPanel>
                        <DockPanel Margin="0,0,8,10">
                            <Border DockPanel.Dock="Right" Style="{StaticResource OverlapChip}" ToolTip="{Binding MetaOverlapToolTip}">
                                <TextBlock Text="{Binding MetaOverlapText}" />
                            </Border>
                            <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                <Run Text="출격 함대" FontSize="14" FontWeight="Bold" />
                                <Run Text="{Binding MetaFleetSummaryText, Mode=OneWay}" FontSize="12" Foreground="{DynamicResource MutedBrush}" />
                            </TextBlock>
                        </DockPanel>
                        <Grid Visibility="{Binding HasMetaPlan, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="17" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="주력" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="5,0,0,2" />
                                <ItemsControl ItemsSource="{Binding MetaPlan.MainSlots}" ItemTemplate="{StaticResource MetaSlotTemplate}"
                                              ItemsPanel="{StaticResource SlotRowPanel}" Focusable="False" />
                            </StackPanel>
                            <Rectangle Grid.Column="1" Width="1" Margin="0,18,8,4" HorizontalAlignment="Center"
                                       Fill="{DynamicResource SubtleLineBrush}" />
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="전위" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="5,0,0,2" />
                                <ItemsControl ItemsSource="{Binding MetaPlan.VanguardSlots}" ItemTemplate="{StaticResource MetaSlotTemplate}"
                                              ItemsPanel="{StaticResource SlotRowPanel}" Focusable="False" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Margin="0,0,8,6" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}"
                                   Visibility="{Binding HasNoMetaPlan, Converter={StaticResource BoolToVisibilityConverter}}"
                                   Text="이 보스에 맞는 커뮤니티 등급이 있는 Lv.120 이상 함선이 없습니다." />
                        <Border Style="{StaticResource HintPanel}" Margin="0,12,8,0"
                                Visibility="{Binding HasMetaHint, Converter={StaticResource BoolToVisibilityConverter}}">
                            <DockPanel>
                                <TextBlock Text="i" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,8,0" />
                                <TextBlock Text="{Binding MetaHintText}" TextWrapping="Wrap" FontSize="12"
                                           Foreground="{DynamicResource SecondaryTextBrush}" />
                            </DockPanel>
                        </Border>
                        <TextBlock Margin="0,10,8,0" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource MutedBrush}"
                                   Text="함선을 누르면 오른쪽에 그 함선의 장비 추천이 열립니다. 별표(*) 등급은 이 보스의 조건에 맞을 때만 감점하지 않습니다." />
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel x:Name="SideSection" Grid.Column="2">
                <TextBlock Margin="0,0,0,10" TextTrimming="CharacterEllipsis">
                    <Run Text="장비 추천" FontSize="16" FontWeight="Bold" />
                    <Run Text="Regal 순위 · 보유 장비로 대체" FontSize="12" Foreground="{DynamicResource MutedBrush}" />
                </TextBlock>
                <views:GearPanelView Panel="{Binding MetaGearPanel}" />
            </StackPanel>
        </Grid>

        <!-- 실전 기록: what each captured META fight did, and what stands out in it. -->
        <DockPanel Margin="0,28,0,10">
            <TextBlock DockPanel.Dock="Right" Text="CS 40001·40003 패킷 기준 · 보스 피해는 보스가 받은 피해" FontSize="11"
                       Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Bottom" Margin="12,0,0,0" />
            <TextBlock TextTrimming="CharacterEllipsis">
                <Run Text="실전 기록" FontSize="16" FontWeight="Bold" />
                <Run Text="{Binding MetaFightLog.SummaryText, Mode=OneWay}" FontSize="12" Foreground="{DynamicResource MutedBrush}" />
            </TextBlock>
        </DockPanel>
        <Border Style="{StaticResource SectionPanel}" Visibility="{Binding HasNoMetaFights, Converter={StaticResource BoolToVisibilityConverter}}">
            <TextBlock Text="{Binding MetaFightEmptyText}" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" />
        </Border>
        <Grid x:Name="FightBody" Visibility="{Binding HasMetaFights, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="FightListColumn" Width="2*" MinWidth="280" />
                <ColumnDefinition x:Name="FightGapColumn" Width="20" />
                <ColumnDefinition x:Name="FightDetailColumn" Width="3*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border x:Name="FightListSection" Style="{StaticResource SectionPanel}" Padding="8" VerticalAlignment="Top">
                <ScrollViewer MaxHeight="620" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                    <ItemsControl ItemsSource="{Binding MetaFightLog.Fights}" ItemTemplate="{StaticResource FightRowTemplate}" Focusable="False" />
                </ScrollViewer>
            </Border>

            <Border x:Name="FightDetailSection" Grid.Column="2" Style="{StaticResource SectionPanel}" Padding="18,14" VerticalAlignment="Top"
                    DataContext="{Binding SelectedMetaFight}">
                <StackPanel>
                    <DockPanel>
                        <Border DockPanel.Dock="Right" Style="{StaticResource FightResultChip}" VerticalAlignment="Top">
                            <TextBlock Text="{Binding ResultText}" />
                        </Border>
                        <TextBlock FontSize="12" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis">
                            <Run Text="{Binding WhenText, Mode=OneWay}" />
                            <Run Text="·" />
                            <Run Text="{Binding OwnerText, Mode=OneWay}" />
                            <Run Text="{Binding LevelText, Mode=OneWay}" />
                        </TextBlock>
                    </DockPanel>
                    <TextBlock Margin="0,4,0,0">
                        <Run Text="{Binding DamageText, Mode=OneWay}" FontSize="22" FontWeight="Bold" />
                        <Run Text="{Binding PercentText, Mode=OneWay}" FontSize="12" Foreground="{DynamicResource MutedBrush}" />
                    </TextBlock>
                    <Border Style="{StaticResource BarTrack}" Height="8" CornerRadius="4" Margin="0,8,0,0">
                        <Border Style="{StaticResource BarFill}" CornerRadius="4">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="{Binding DamageFraction}" />
                            </Border.RenderTransform>
                        </Border>
                    </Border>
                    <WrapPanel Margin="0,10,0,0">
                        <StackPanel Margin="0,0,24,4">
                            <TextBlock Text="전투" Style="{StaticResource FactLabel}" />
                            <TextBlock Text="{Binding TimeText}" FontSize="13" FontWeight="SemiBold" Margin="0,1,0,0" />
                        </StackPanel>
                        <StackPanel Margin="0,0,24,4">
                            <TextBlock Text="피해 비중" Style="{StaticResource FactLabel}" />
                            <TextBlock Text="{Binding ShareSummaryText}" FontSize="13" FontWeight="SemiBold" Margin="0,1,0,0" />
                        </StackPanel>
                        <StackPanel Margin="0,0,0,4">
                            <TextBlock Text="장비" Style="{StaticResource FactLabel}" />
                            <TextBlock Text="{Binding GearNoteText}" FontSize="13" FontWeight="SemiBold" Margin="0,1,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </WrapPanel>

                    <Border BorderBrush="{DynamicResource SubtleLineBrush}" BorderThickness="0,1,0,0" Margin="0,10,0,0" Padding="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="진단" FontSize="14" FontWeight="Bold" Margin="0,0,0,10" />
                            <ItemsControl ItemsSource="{Binding Findings}" ItemTemplate="{StaticResource FindingTemplate}" Focusable="False" />
                        </StackPanel>
                    </Border>

                    <Border BorderBrush="{DynamicResource SubtleLineBrush}" BorderThickness="0,1,0,0" Margin="0,2,0,0" Padding="0,12,0,0">
                        <StackPanel>
                            <TextBlock Margin="0,0,0,10">
                                <Run Text="함선별 피해" FontSize="14" FontWeight="Bold" />
                                <Run Text="막대는 이 전투 최고 피해 대비 · % 는 함대 피해 중 비중" FontSize="11" Foreground="{DynamicResource MutedBrush}" />
                            </TextBlock>
                            <TextBlock Text="주력" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,6" />
                            <ItemsControl ItemsSource="{Binding MainShips}" ItemTemplate="{StaticResource FightShipTemplate}" Focusable="False" />
                            <TextBlock Text="전위" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,6" />
                            <ItemsControl ItemsSource="{Binding VanguardShips}" ItemTemplate="{StaticResource FightShipTemplate}" Focusable="False" />
                            <TextBlock Text="패킷에는 격침 시점이 없어 격침으로 잃은 피해량은 계산하지 않습니다." FontSize="11"
                                       Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </StackPanel>
</UserControl>
