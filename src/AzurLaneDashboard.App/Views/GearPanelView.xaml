<UserControl x:Class="AzurLaneDashboard.App.Views.GearPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             Foreground="{DynamicResource TextBrush}"
             FontSize="13">
    <!-- The 장비 추천 card shared by META 보스전 and 쫄작. Panel holds the selected ship's rows; the source
         toggle binds to the inherited FleetPlannerViewModel, so both tabs share one 옮기기 포함/창고만 setting. -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="FleetPlannerShared.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <DataTemplate x:Key="GearRowTemplate">
                <Border Padding="14,8" BorderBrush="{DynamicResource SubtleLineBrush}" BorderThickness="0,1,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel HorizontalAlignment="Center" Margin="0,2,0,0">
                            <TextBlock Text="{Binding Slot}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource MutedBrush}"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding SlotLabel}" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <DockPanel>
                                <Border Width="26" Height="26" CornerRadius="5" Background="{DynamicResource InputBrush}"
                                        BorderBrush="{DynamicResource SubtleLineBrush}" BorderThickness="1" Margin="0,0,8,0">
                                    <Image Source="{Binding IconUrl, Converter={StaticResource AssetImageConverter}}" Stretch="Uniform"
                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                </Border>
                                <TextBlock x:Name="Action" DockPanel.Dock="Right" Text="{Binding ActionText}" FontSize="11" FontWeight="Bold"
                                           Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="8,0,0,0"
                                           ToolTip="{Binding ActionToolTip}" />
                                <Border x:Name="Rank" DockPanel.Dock="Left" CornerRadius="4" BorderThickness="1" Padding="4,0" Margin="0,0,6,0"
                                        BorderBrush="{DynamicResource LineBrush}" VerticalAlignment="Center">
                                    <TextBlock x:Name="RankText" Text="{Binding RankText}" FontSize="10" FontWeight="Bold"
                                               Foreground="{DynamicResource MutedBrush}" />
                                </Border>
                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                            </DockPanel>
                            <TextBlock Text="{Binding SubText}" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="34,2,0,0"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding SubText}" />
                            <TextBlock Text="{Binding AltText}" FontSize="11" Foreground="{DynamicResource GoodBrush}" Margin="34,2,0,0"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding AltText}"
                                       Visibility="{Binding HasAlt, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </StackPanel>
                    </Grid>
                </Border>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding ActionKind}" Value="move-sortie">
                        <Setter TargetName="Action" Property="Foreground" Value="{DynamicResource WarnBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding ActionKind}" Value="bag">
                        <Setter TargetName="Action" Property="Foreground" Value="{DynamicResource GoodBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding ActionKind}" Value="keep">
                        <Setter TargetName="Action" Property="Foreground" Value="{DynamicResource GoodBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding ActionKind}" Value="hold">
                        <Setter TargetName="Action" Property="Foreground" Value="{DynamicResource MutedBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding ActionKind}" Value="missing">
                        <Setter TargetName="Action" Property="Foreground" Value="{DynamicResource WarnBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsOutOfRank}" Value="True">
                        <Setter TargetName="Rank" Property="BorderBrush" Value="{DynamicResource WarnSubtleBrush}" />
                        <Setter TargetName="RankText" Property="Foreground" Value="{DynamicResource WarnBrush}" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Style="{StaticResource SectionPanel}" Padding="0" ClipToBounds="True">
        <StackPanel>
            <DockPanel Margin="14,12,14,10">
                <Border DockPanel.Dock="Right" Style="{StaticResource SegmentFrame}">
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource SegmentButton}" Content="옮기기 포함" Tag="{Binding IsGearMoveMode}"
                                Command="{Binding SetGearModeCommand}" CommandParameter="move" />
                        <Button Style="{StaticResource SegmentButton}" Content="창고만" Tag="{Binding IsGearBagMode}"
                                Command="{Binding SetGearModeCommand}" CommandParameter="bag" />
                    </StackPanel>
                </Border>
                <Border Width="30" Height="30" CornerRadius="6" ClipToBounds="True" Background="{DynamicResource InputBrush}"
                        Margin="0,0,8,0" Visibility="{Binding Panel.HasShip, ElementName=Root, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Image Source="{Binding Panel.IconUrl, ElementName=Root, Converter={StaticResource AssetImageConverter}}"
                           Stretch="UniformToFill" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Panel.ShipName, ElementName=Root}" FontWeight="Bold" FontSize="14"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Panel.ShipSubText, ElementName=Root}" FontSize="12" Foreground="{DynamicResource MutedBrush}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </DockPanel>
            <ItemsControl ItemsSource="{Binding Panel.Rows, ElementName=Root}" ItemTemplate="{StaticResource GearRowTemplate}"
                          Focusable="False" />
            <TextBlock Margin="14,8,14,12" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}"
                       Visibility="{Binding Panel.HasNoRows, ElementName=Root, Converter={StaticResource BoolToVisibilityConverter}}"
                       Text="이 함선의 커뮤니티 장비 순위가 없습니다." />
            <DockPanel Margin="14,8,14,10">
                <TextBlock DockPanel.Dock="Right" Text="{Binding Panel.ArmorNote, ElementName=Root}" FontSize="11"
                           Foreground="{DynamicResource MutedBrush}" />
                <TextBlock Text="{Binding Panel.FootText, ElementName=Root}" FontSize="11" Foreground="{DynamicResource MutedBrush}"
                           TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </StackPanel>
    </Border>
</UserControl>
