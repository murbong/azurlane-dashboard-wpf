<UserControl x:Class="AzurLaneDashboard.App.Views.TopToolbarView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:views="clr-namespace:AzurLaneDashboard.App.Views">
 <StackPanel>
  <!-- Page heading and page-level actions -->
  <Grid Margin="0,0,0,14">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
   <StackPanel VerticalAlignment="Center">
    <TextBlock Text="{Binding PageTitle}" FontSize="22" FontWeight="SemiBold" />
    <TextBlock Text="{Binding PageDescription}" Style="{StaticResource MutedText}" FontSize="12.5" TextTrimming="CharacterEllipsis" Margin="0,2,20,0" />
   </StackPanel>
   <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
    <Button Command="{Binding ReloadCommand}" ToolTip="저장된 데이터 다시 읽기 (F5)" Margin="0,0,6,0">
     <StackPanel Orientation="Horizontal">
      <TextBlock Text="&#xE72C;" Style="{StaticResource IconText}" FontSize="13" Margin="0,0,7,0" />
      <TextBlock Text="새로고침" VerticalAlignment="Center" />
     </StackPanel>
    </Button>
    <Button Command="{Binding ExportWorkbookCommand}" Style="{StaticResource QuietButton}" ToolTip="전체 데이터를 Excel 파일로 저장">
     <StackPanel Orientation="Horizontal">
      <TextBlock Text="&#xEDE1;" Style="{StaticResource IconText}" FontSize="13" Margin="0,0,7,0" />
      <TextBlock Text="내보내기" VerticalAlignment="Center" />
     </StackPanel>
    </Button>
   </StackPanel>
  </Grid>

  <!-- Search for list pages without their own tab strip. Pages with tabs host the bar under their tabs
       (TabTools.Content) so switching tabs never pushes the tab strip down. -->
  <Border x:Name="InventoryTools"
          Visibility="{Binding IsToolbarSearchVisible, Converter={StaticResource BoolToVisibilityConverter}}">
   <views:InventorySearchBar />
  </Border>
 </StackPanel>
</UserControl>
