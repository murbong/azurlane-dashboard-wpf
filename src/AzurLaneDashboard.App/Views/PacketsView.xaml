<UserControl x:Class="AzurLaneDashboard.App.Views.PacketsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <UniformGrid Columns="4">
            <Border Style="{StaticResource KpiCard}">
                <StackPanel>
                    <TextBlock Text="저장 페이로드" Style="{StaticResource MutedText}" />
                    <TextBlock Text="{Binding PacketPayloadsSaved, StringFormat={}{0:N0}}"
                               FontSize="22" FontWeight="SemiBold" Margin="0,2,0,0" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource KpiCard}">
                <StackPanel>
                    <TextBlock Text="알려진 패킷" Style="{StaticResource MutedText}" />
                    <TextBlock Text="{Binding KnownPacketsSeen, StringFormat={}{0:N0}}"
                               FontSize="22" FontWeight="SemiBold" Margin="0,2,0,0" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource KpiCard}">
                <StackPanel>
                    <TextBlock Text="디코드 성공" Style="{StaticResource MutedText}" />
                    <TextBlock Text="{Binding KnownPacketsDecoded, StringFormat={}{0:N0}}"
                               FontSize="22" FontWeight="SemiBold" Margin="0,2,0,0" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource KpiCard}" Margin="0">
                <StackPanel>
                    <TextBlock Text="디코드 실패" Style="{StaticResource MutedText}" />
                    <TextBlock Text="{Binding DecodeFailuresSaved, StringFormat={}{0:N0}}"
                               FontSize="22" FontWeight="SemiBold" Margin="0,2,0,0" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Retired storage cleanup: backs the DB up, then drops what this build no longer uses. -->
        <Border Grid.Row="1" Style="{StaticResource SectionPanel}" Margin="0,14,0,0" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="안 쓰는 DB 저장소 정리" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="{Binding RetiredStorageBlockedText}"
                                   Style="{StaticResource MutedText}"
                                   Foreground="{DynamicResource WarnBrush}"
                                   VerticalAlignment="Center"
                                   Margin="12,0,0,0" />
                    </StackPanel>
                    <TextBlock Text="{Binding RetiredStorageText}"
                               Style="{StaticResource MutedText}"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0" />
                </StackPanel>
                <Button Grid.Column="1"
                        MinWidth="112"
                        VerticalAlignment="Center"
                        Content="{Binding RetiredStorageButtonText}"
                        Command="{Binding CleanupRetiredStorageCommand}" />
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="2*" />
                <RowDefinition Height="1.2*" />
            </Grid.RowDefinitions>

            <Border Style="{StaticResource SectionPanel}" Margin="0,0,0,8">
                <DockPanel LastChildFill="True">
                    <TextBlock DockPanel.Dock="Top"
                               Text="디코드 성공 / 해석 상태"
                               Style="{StaticResource SectionTitle}"
                               Margin="0,0,0,10" />
                    <DataGrid ItemsSource="{Binding PacketStats}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="패킷" Binding="{Binding PacketName}" Width="130" />
                            <DataGridTextColumn Header="ID" Binding="{Binding PacketId}" Width="80" />
                            <DataGridTextColumn Header="상태" Binding="{Binding DecodeStatus}" Width="110" />
                            <DataGridTextColumn Header="설명" Binding="{Binding Description}" Width="2*" />
                            <DataGridTextColumn Header="횟수" Binding="{Binding Count, StringFormat={}{0:N0}}" Width="90" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource SectionPanel}" Margin="0,8,8,0">
                    <DockPanel LastChildFill="True">
                        <TextBlock DockPanel.Dock="Top"
                                   Text="해석 미구현 상위"
                                   Style="{StaticResource SectionTitle}"
                                   Margin="0,0,0,10" />
                        <DataGrid ItemsSource="{Binding PacketInterpretationGaps}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="패킷" Binding="{Binding PacketName}" Width="110" />
                                <DataGridTextColumn Header="ID" Binding="{Binding PacketId}" Width="72" />
                                <DataGridTextColumn Header="설명" Binding="{Binding Description}" Width="*" />
                                <DataGridTextColumn Header="횟수" Binding="{Binding Count, StringFormat={}{0:N0}}" Width="82" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource SectionPanel}" Margin="8,8,0,0">
                    <DockPanel LastChildFill="True">
                        <TextBlock DockPanel.Dock="Top"
                                   Text="디코드 실패 상위"
                                   Style="{StaticResource SectionTitle}"
                                   Margin="0,0,0,10" />
                        <DataGrid ItemsSource="{Binding DecodeFailures}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="패킷" Binding="{Binding PacketName}" Width="*" />
                                <DataGridTextColumn Header="ID" Binding="{Binding PacketId}" Width="82" />
                                <DataGridTextColumn Header="사유" Binding="{Binding Reason}" Width="150" />
                                <DataGridTextColumn Header="횟수" Binding="{Binding Count, StringFormat={}{0:N0}}" Width="82" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
