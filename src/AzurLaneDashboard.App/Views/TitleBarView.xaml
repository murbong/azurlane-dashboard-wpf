<UserControl x:Class="AzurLaneDashboard.App.Views.TitleBarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="{DynamicResource TextBrush}"
             FontSize="13">
    <Border Background="{DynamicResource ShellBrush}"
            BorderBrush="{DynamicResource SubtleLineBrush}"
            BorderThickness="0,0,0,1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="14,0,0,0">
                <Image Source="pack://application:,,,/AzurLaneDashboard.App;component/Assets/app-icon.png"
                       Width="18"
                       Height="18"
                       Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock Text="Azur Lane Dashboard"
                           Margin="10,0,0,0"
                           VerticalAlignment="Center"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource SecondaryTextBrush}" />
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Style="{StaticResource TitleBarButton}"
                        Content="&#xE921;"
                        Click="MinimizeButton_Click"
                        ToolTip="최소화"
                        AutomationProperties.Name="최소화" />
                <Button x:Name="MaximizeButton"
                        Style="{StaticResource TitleBarButton}"
                        Content="&#xE922;"
                        Click="MaximizeButton_Click"
                        ToolTip="최대화"
                        AutomationProperties.Name="최대화" />
                <Button Style="{StaticResource CloseTitleBarButton}"
                        Content="&#xE8BB;"
                        Click="CloseButton_Click"
                        ToolTip="닫기"
                        AutomationProperties.Name="닫기" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
