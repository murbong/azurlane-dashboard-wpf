<UserControl x:Class="AzurLaneDashboard.App.Views.PersonalTaskView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="{DynamicResource TextBrush}"
             FontSize="13">
    <!-- 캐릭터 임무. DataContext is the PersonalTaskViewModel. -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="FleetPlannerShared.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <DataTemplate x:Key="FilterTemplate">
                <Button Style="{StaticResource SegmentButton}" Content="{Binding Text}" Tag="{Binding IsSelected}" Margin="0,0,2,0"
                        Command="{Binding DataContext.SelectFilterCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding}" />
            </DataTemplate>

            <!-- A chain: the ship, how many steps are done, the open step and its progress, the status chip. -->
            <DataTemplate x:Key="RowTemplate">
                <Border Padding="16,8" BorderBrush="{DynamicResource SubtleLineBrush}" BorderThickness="0,1,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Portrait}" Width="40" Height="40" VerticalAlignment="Top" BorderThickness="0,0,0,2">
                            <Image Source="{Binding IconUrl, Converter={StaticResource AssetImageConverter}}" Stretch="UniformToFill"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock TextTrimming="CharacterEllipsis">
                                <Run Text="{Binding ShipName, Mode=OneWay}" FontWeight="Bold" />
                                <Run Text="{Binding StepText, Mode=OneWay}" FontSize="12" Foreground="{DynamicResource MutedBrush}" />
                            </TextBlock>
                            <TextBlock Text="{Binding SubText}" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}"
                                       Margin="0,2,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding SubText}" />
                            <StackPanel Margin="0,4,0,0" Visibility="{Binding HasProgress, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="{Binding StepDesc}" FontSize="12" TextWrapping="Wrap" />
                                <DockPanel Margin="0,4,0,0" MaxWidth="420" HorizontalAlignment="Left">
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding ProgressText}" FontSize="12" Margin="8,0,0,0"
                                               Foreground="{DynamicResource MutedBrush}" />
                                    <ProgressBar Width="220" Height="5" Minimum="0" Maximum="1" Value="{Binding Fraction, Mode=OneWay}"
                                                 VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}"
                                                 Background="{DynamicResource InputBrush}" BorderThickness="0" />
                                </DockPanel>
                            </StackPanel>
                        </StackPanel>
                        <Border Grid.Column="3" Style="{StaticResource QueueStatusChip}" Margin="8,0,0,0" VerticalAlignment="Top">
                            <TextBlock Text="{Binding StatusText}" />
                        </Border>
                    </Grid>
                </Border>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <StackPanel Margin="0,0,8,16">
            <Border Style="{StaticResource SectionPanel}" Padding="16,14"
                    Visibility="{Binding HasNoData, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}"
                           Text="임무 기록이 없습니다. 캡처를 켠 채로 게임에 다시 접속하면 채워집니다." />
            </Border>

            <StackPanel Visibility="{Binding HasData, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock Margin="0,0,0,10" TextTrimming="CharacterEllipsis">
                    <Run Text="캐릭터 임무" FontSize="16" FontWeight="Bold" />
                    <Run Text="{Binding Dashboard.BasisText, Mode=OneWay}" FontSize="12" Foreground="{DynamicResource MutedBrush}" />
                </TextBlock>

                <WrapPanel Margin="0,0,0,12">
                    <Border Style="{StaticResource KpiCard}" MinWidth="140" Margin="0,0,10,8">
                        <StackPanel>
                            <TextBlock Text="진행 중" FontSize="12" Foreground="{DynamicResource MutedBrush}" />
                            <TextBlock Text="{Binding Dashboard.ActiveCount}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource KpiCard}" MinWidth="140" Margin="0,0,10,8">
                        <StackPanel>
                            <TextBlock Text="시작 가능" FontSize="12" Foreground="{DynamicResource MutedBrush}" />
                            <TextBlock Text="{Binding Dashboard.ReadyCount}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource WarnBrush}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource KpiCard}" MinWidth="140" Margin="0,0,10,8">
                        <StackPanel>
                            <TextBlock Text="완료" FontSize="12" Foreground="{DynamicResource MutedBrush}" />
                            <TextBlock Text="{Binding Dashboard.DoneCount}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource GoodBrush}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource KpiCard}" MinWidth="140" Margin="0,0,10,8">
                        <StackPanel>
                            <TextBlock Text="미보유" FontSize="12" Foreground="{DynamicResource MutedBrush}" />
                            <TextBlock Text="{Binding Dashboard.LockedCount}" FontSize="22" FontWeight="Bold" />
                        </StackPanel>
                    </Border>
                </WrapPanel>

                <Border Style="{StaticResource SectionPanel}" Padding="16,12" Margin="0,0,0,14">
                    <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}">
                        <Run Text="시작하는 법" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" />
                        <Run Text="함선을 비서함으로 두고 메인 화면에서 터치하면 그 함선의 개인 임무가 시작됩니다. 수집 메뉴에서 그 함선의 이야기를 열어도 시작됩니다. 마지막 로그인 목록과 그 뒤 진행·완료 기록을 기준으로 합니다." />
                    </TextBlock>
                </Border>

                <Border Style="{StaticResource SegmentFrame}" HorizontalAlignment="Left" Margin="0,0,0,10">
                    <ItemsControl ItemsSource="{Binding Filters}" ItemTemplate="{StaticResource FilterTemplate}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </Border>

                <Border Style="{StaticResource SectionPanel}" Padding="0,0,0,4" ClipToBounds="True">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding VisibleRows}" ItemTemplate="{StaticResource RowTemplate}" Focusable="False" />
                        <TextBlock Margin="16,12" Foreground="{DynamicResource SecondaryTextBrush}" Text="이 분류에 해당하는 함선이 없습니다."
                                   Visibility="{Binding HasNoVisibleRows, Converter={StaticResource BoolToVisibilityConverter}}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
