<UserControl x:Class="AzurLaneDashboard.App.Views.OpsiView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="{DynamicResource TextBrush}"
             FontSize="13"
             SizeChanged="OnSizeChanged">
    <!-- 대형작전. DataContext is the OpsiViewModel. -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="FleetPlannerShared.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="LeftText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsOneLeft}" Value="True">
                        <Setter Property="Foreground" Value="{DynamicResource GoodBrush}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- A target under an action: the area, how far along, what is left, the area's next star reward. -->
            <DataTemplate x:Key="ActionRowTemplate">
                <Border Padding="16,7" BorderBrush="{DynamicResource SubtleLineBrush}" BorderThickness="0,1,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" MinWidth="90" />
                            <ColumnDefinition Width="64" />
                            <ColumnDefinition Width="1.3*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding AreaLabel}" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding SubText}" FontSize="11" Foreground="{DynamicResource MutedBrush}" />
                        </StackPanel>
                        <DockPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding ProgressText}" FontSize="12" Margin="8,0,0,0"
                                       Foreground="{DynamicResource MutedBrush}" />
                            <ProgressBar Height="5" Minimum="0" Maximum="1" Value="{Binding Fraction, Mode=OneWay}" VerticalAlignment="Center"
                                         Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource InputBrush}" BorderThickness="0" />
                        </DockPanel>
                        <TextBlock Grid.Column="2" Text="{Binding LeftText}" Style="{StaticResource LeftText}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="3" Text="{Binding RewardText}" FontSize="12" Foreground="{DynamicResource WarnBrush}"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding RewardText}" />
                    </Grid>
                </Border>
            </DataTemplate>

            <DataTemplate x:Key="ActionGroupTemplate">
                <Border Style="{StaticResource SectionPanel}" Padding="0,0,0,4" Margin="0,0,0,12" ClipToBounds="True">
                    <StackPanel>
                        <DockPanel Margin="16,12,16,2">
                            <Border DockPanel.Dock="Right" Style="{StaticResource AccentChip}">
                                <TextBlock Text="{Binding SummaryText}" />
                            </Border>
                            <TextBlock Text="{Binding Action}" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                        <TextBlock Margin="16,2,16,8" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}">
                            <Run Text="{Binding What, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
                            <Run Text="{Binding How, Mode=OneWay}" />
                        </TextBlock>
                        <ItemsControl ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource ActionRowTemplate}" Focusable="False" />
                    </StackPanel>
                </Border>
            </DataTemplate>

            <!-- A target inside an area card: which target, the hidden mark, how far along. -->
            <DataTemplate x:Key="AreaTargetTemplate">
                <Border Padding="16,6" BorderBrush="{DynamicResource SubtleLineBrush}" BorderThickness="0,1,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="64" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding Desc}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Desc}" />
                            <TextBlock FontSize="11" Foreground="{DynamicResource MutedBrush}">
                                <Run Text="{Binding TargetName, Mode=OneWay}" />
                                <Run Text="·" />
                                <Run Text="{Binding KindText, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                        <DockPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding ProgressText}" FontSize="12" Margin="8,0,0,0"
                                       Foreground="{DynamicResource MutedBrush}" />
                            <ProgressBar Height="5" Minimum="0" Maximum="1" Value="{Binding Fraction, Mode=OneWay}" VerticalAlignment="Center"
                                         Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource InputBrush}" BorderThickness="0" />
                        </DockPanel>
                        <TextBlock Grid.Column="2" Text="{Binding LeftText}" Style="{StaticResource LeftText}" VerticalAlignment="Center" />
                    </Grid>
                </Border>
            </DataTemplate>

            <DataTemplate x:Key="AreaTemplate">
                <Border Style="{StaticResource SectionPanel}" Padding="0,0,0,4" Margin="0,0,0,12" ClipToBounds="True">
                    <StackPanel>
                        <DockPanel Margin="16,12,16,6">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding RewardText}" FontSize="12" Foreground="{DynamicResource WarnBrush}"
                                       VerticalAlignment="Center" Margin="8,0,0,0" />
                            <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                <Run Text="{Binding Label, Mode=OneWay}" FontSize="14" FontWeight="Bold" />
                                <Run Text="{Binding StarsText, Mode=OneWay}" FontSize="12" Foreground="{DynamicResource MutedBrush}" />
                            </TextBlock>
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding Targets}" ItemTemplate="{StaticResource AreaTargetTemplate}" Focusable="False" />
                    </StackPanel>
                </Border>
            </DataTemplate>

            <DataTemplate x:Key="QuickTemplate">
                <Border Padding="0,6" BorderBrush="{DynamicResource SubtleLineBrush}" BorderThickness="0,1,0,0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding ProgressText}" FontSize="12" Foreground="{DynamicResource MutedBrush}"
                                   Margin="8,0,0,0" VerticalAlignment="Center" />
                        <TextBlock TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding Desc}">
                            <Run Text="{Binding AreaLabel, Mode=OneWay}" FontWeight="Bold" />
                            <Run Text="{Binding Action, Mode=OneWay}" Foreground="{DynamicResource SecondaryTextBrush}" />
                        </TextBlock>
                    </DockPanel>
                </Border>
            </DataTemplate>

            <Style x:Key="SideTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="Margin" Value="0,0,0,8" />
            </Style>
            <Style x:Key="SideNote" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
            </Style>
            <Style x:Key="NeedLine" TargetType="DockPanel">
                <Setter Property="Margin" Value="0,0,0,6" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <StackPanel Margin="0,0,8,16">
            <Border Style="{StaticResource SectionPanel}" Padding="16,14"
                    Visibility="{Binding HasNoData, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock Style="{StaticResource SideNote}"
                           Text="대형작전 기록이 없습니다. 캡처를 켠 채로 게임에서 대형작전에 한 번 들어가면 채워집니다." />
            </Border>

            <StackPanel Visibility="{Binding HasData, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock Margin="0,0,0,10" TextTrimming="CharacterEllipsis">
                    <Run Text="별 모으기" FontSize="16" FontWeight="Bold" />
                    <Run Text="{Binding Dashboard.BasisText, Mode=OneWay}" FontSize="12" Foreground="{DynamicResource MutedBrush}" />
                </TextBlock>

                <!-- The four numbers that say how far the collection is and whether a reward waits. -->
                <WrapPanel Margin="0,0,0,16">
                    <Border Style="{StaticResource KpiCard}" MinWidth="150" Margin="0,0,10,8">
                        <StackPanel>
                            <TextBlock Text="모은 별" FontSize="12" Foreground="{DynamicResource MutedBrush}" />
                            <TextBlock Text="{Binding Dashboard.StarsText}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource WarnBrush}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource KpiCard}" MinWidth="150" Margin="0,0,10,8">
                        <StackPanel>
                            <TextBlock Text="남은 별" FontSize="12" Foreground="{DynamicResource MutedBrush}" />
                            <TextBlock Text="{Binding Dashboard.StarsLeft}" FontSize="22" FontWeight="Bold" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource KpiCard}" MinWidth="150" Margin="0,0,10,8">
                        <StackPanel>
                            <TextBlock Text="별 다 모은 해역" FontSize="12" Foreground="{DynamicResource MutedBrush}" />
                            <TextBlock Text="{Binding Dashboard.AreasText}" FontSize="22" FontWeight="Bold" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource KpiCard}" MinWidth="150" Margin="0,0,10,8">
                        <StackPanel>
                            <TextBlock Text="받을 별 보상" FontSize="12" Foreground="{DynamicResource MutedBrush}" />
                            <TextBlock Text="{Binding Dashboard.ClaimableCount}" FontSize="22" FontWeight="Bold" />
                        </StackPanel>
                    </Border>
                </WrapPanel>

                <Grid x:Name="Body">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="ListColumn" Width="3*" />
                        <ColumnDefinition x:Name="GapColumn" Width="20" />
                        <ColumnDefinition x:Name="SideColumn" Width="2*" MinWidth="340" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <DockPanel Margin="0,0,0,10">
                            <Border DockPanel.Dock="Right" Style="{StaticResource SegmentFrame}">
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource SegmentButton}" Content="할 일별" Tag="{Binding IsActionView}"
                                            Command="{Binding SetViewCommand}" CommandParameter="action" />
                                    <Button Style="{StaticResource SegmentButton}" Content="해역별" Tag="{Binding IsAreaView}"
                                            Command="{Binding SetViewCommand}" CommandParameter="area" />
                                </StackPanel>
                            </Border>
                            <TextBlock Text="{Binding ListTitle}" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" />
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding Dashboard.Groups}" ItemTemplate="{StaticResource ActionGroupTemplate}" Focusable="False"
                                      Visibility="{Binding IsActionView, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <ItemsControl ItemsSource="{Binding Dashboard.Areas}" ItemTemplate="{StaticResource AreaTemplate}" Focusable="False"
                                      Visibility="{Binding IsAreaView, Converter={StaticResource BoolToVisibilityConverter}}" />
                    </StackPanel>

                    <StackPanel x:Name="SideSection" Grid.Column="2">
                        <Border Style="{StaticResource SectionPanel}" Padding="16,14" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="받을 별 보상" Style="{StaticResource SideTitle}" />
                                <ItemsControl ItemsSource="{Binding Dashboard.Claimable}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Text}" Foreground="{DynamicResource GoodBrush}" Margin="0,0,0,4"
                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Text}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Style="{StaticResource SideNote}" Text="달성한 별의 보상은 모두 받았습니다."
                                           Visibility="{Binding Dashboard.HasNoClaimable, Converter={StaticResource BoolToVisibilityConverter}}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SectionPanel}" Padding="16,14" Margin="0,0,0,12"
                                Visibility="{Binding Dashboard.HasQuickWins, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock Text="한 번만 더 하면 별" Style="{StaticResource SideTitle}" />
                                <ItemsControl ItemsSource="{Binding Dashboard.QuickWins}" ItemTemplate="{StaticResource QuickTemplate}" Focusable="False" />
                            </StackPanel>
                        </Border>

                        <!-- Both Siren devices run on the energy container; the count is the one in the entry snapshot. -->
                        <Border Style="{StaticResource SectionPanel}" Padding="16,14" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="세이렌 장치에 드는 아이템" Style="{StaticResource SideTitle}" />
                                <TextBlock Text="정보 수집 장치" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Dashboard.InfoNeedText}" Style="{StaticResource SideNote}" Margin="0,2,0,8" />
                                <TextBlock Text="탐지 장치" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Dashboard.DetectionNeedText}" Style="{StaticResource SideNote}" Margin="0,2,0,8" />
                                <TextBlock Text="{Binding Dashboard.DeviceVerdict}" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="{DynamicResource GoodBrush}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Dashboard.IsEnergyShort}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource WarnBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Style="{StaticResource SideNote}" Margin="0,6,0,0" FontSize="11" Foreground="{DynamicResource MutedBrush}"
                                           Text="보유 수는 대형작전에 들어갈 때 기준입니다. 탐지 장치를 토큰(숨은 자원 찾기)으로 써도 사용 횟수에 드는지는 게임에서 확인해 주세요." />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SectionPanel}" Padding="16,14" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="숨은 목표" Style="{StaticResource SideTitle}" />
                                <TextBlock Style="{StaticResource SideNote}" Text="{Binding Dashboard.HiddenText}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SectionPanel}" Padding="16,14">
                            <StackPanel>
                                <TextBlock Text="적응도" Style="{StaticResource SideTitle}" />
                                <UniformGrid Columns="3" Margin="0,0,0,8">
                                    <Border Style="{StaticResource InsetPanel}" Margin="0,0,6,0" Padding="10,8">
                                        <StackPanel>
                                            <TextBlock Text="공격" FontSize="11" Foreground="{DynamicResource MutedBrush}" />
                                            <TextBlock Text="{Binding Dashboard.AdaptAttack}" FontSize="18" FontWeight="Bold" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource InsetPanel}" Margin="0,0,6,0" Padding="10,8">
                                        <StackPanel>
                                            <TextBlock Text="내구" FontSize="11" Foreground="{DynamicResource MutedBrush}" />
                                            <TextBlock Text="{Binding Dashboard.AdaptDurability}" FontSize="18" FontWeight="Bold" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource InsetPanel}" Padding="10,8">
                                        <StackPanel>
                                            <TextBlock Text="회복" FontSize="11" Foreground="{DynamicResource MutedBrush}" />
                                            <TextBlock Text="{Binding Dashboard.AdaptRecovery}" FontSize="18" FontWeight="Bold" />
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>
                                <TextBlock Style="{StaticResource SideNote}"
                                           Text="공격은 세이렌 공격력, 내구는 세이렌 HP, 회복은 아군 회복을 막는 효과에 대응합니다. 위험도별 해역 추천은 해역의 지금 위험도를 읽는 방법을 확인한 뒤 붙입니다." />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
