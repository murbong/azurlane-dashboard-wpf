<UserControl x:Class="AzurLaneDashboard.App.Views.SidebarView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:views="clr-namespace:AzurLaneDashboard.App.Views">
 <UserControl.Resources>
  <!-- Green while an emulator is capturing that account right now, the same meaning as the capture card's dot. -->
  <Style x:Key="AccountLiveDot" TargetType="Ellipse">
   <Setter Property="Width" Value="7" />
   <Setter Property="Height" Value="7" />
   <Setter Property="VerticalAlignment" Value="Center" />
   <Setter Property="Margin" Value="0,1,8,0" />
   <Setter Property="Fill" Value="{DynamicResource MutedBrush}" />
   <Style.Triggers>
    <DataTrigger Binding="{Binding IsLive}" Value="True"><Setter Property="Fill" Value="{DynamicResource GoodBrush}" /></DataTrigger>
   </Style.Triggers>
  </Style>
  <DataTemplate x:Key="AccountSelectedTemplate">
   <StackPanel Orientation="Horizontal">
    <Ellipse Style="{StaticResource AccountLiveDot}" />
    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="92" VerticalAlignment="Center" />
    <TextBlock Text="{Binding ServerText}" Foreground="{DynamicResource MutedBrush}" FontSize="12" TextTrimming="CharacterEllipsis"
               MaxWidth="56" Margin="6,0,0,0" VerticalAlignment="Center" />
   </StackPanel>
  </DataTemplate>
  <DataTemplate x:Key="AccountChoiceTemplate">
   <Grid Margin="0,3">
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
    <Ellipse Style="{StaticResource AccountLiveDot}" VerticalAlignment="Top" Margin="0,6,8,0" />
    <StackPanel Grid.Column="1">
     <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
     <TextBlock Text="{Binding Detail}" Style="{StaticResource CaptionText}" />
     <TextBlock x:Name="Live" Text="{Binding LiveText}" Style="{StaticResource CaptionText}" Foreground="{DynamicResource GoodBrush}" />
    </StackPanel>
   </Grid>
   <DataTemplate.Triggers>
    <DataTrigger Binding="{Binding IsLive}" Value="False"><Setter TargetName="Live" Property="Visibility" Value="Collapsed" /></DataTrigger>
   </DataTemplate.Triggers>
  </DataTemplate>
  <views:ComboBoxChoiceTemplateSelector x:Key="AccountTemplateSelector"
                                        SelectedTemplate="{StaticResource AccountSelectedTemplate}"
                                        DropDownTemplate="{StaticResource AccountChoiceTemplate}" />
 </UserControl.Resources>
 <Border Background="{DynamicResource ShellBrush}" BorderBrush="{DynamicResource SubtleLineBrush}" BorderThickness="0,0,1,0" Padding="12,16,12,12">
  <DockPanel>
   <StackPanel DockPanel.Dock="Top" Margin="10,0,0,10">
    <TextBlock Text="AZUR LANE" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
    <TextBlock Text="나의 모항" FontSize="20" FontWeight="Bold" Margin="0,2,0,0" />
    <!-- One account: whose data this is, on a line that costs no menu space. Two or more get the picker below. -->
    <StackPanel Orientation="Horizontal" Margin="0,3,0,0"
                Visibility="{Binding ShowsSingleAccount, Converter={StaticResource BoolToVisibilityConverter}}"
                ToolTip="{Binding SelectedAccount.Detail}">
     <Ellipse DataContext="{Binding SelectedAccount}" Style="{StaticResource AccountLiveDot}" Width="6" Height="6" Margin="0,1,6,0" />
     <TextBlock Text="{Binding SelectedAccount.Summary}" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}"
                TextTrimming="CharacterEllipsis" MaxWidth="170" VerticalAlignment="Center"
                AutomationProperties.Name="{Binding SelectedAccount.Detail, StringFormat=보는 계정 {0}}" />
    </StackPanel>
   </StackPanel>

   <!-- The account on screen, once there is more than one to choose from. Each account keeps its own data;
        picking one reloads every page from it. -->
   <ComboBox DockPanel.Dock="Top" Margin="0,0,0,8"
             Visibility="{Binding HasMultipleAccounts, Converter={StaticResource BoolToVisibilityConverter}}"
             ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedAccount, Mode=TwoWay}"
             ItemTemplateSelector="{StaticResource AccountTemplateSelector}"
             IsEnabled="{Binding CanSwitchAccount}" ToolTip="{Binding AccountPickerToolTip}"
             ToolTipService.ShowOnDisabled="True"
             AutomationProperties.Name="볼 계정" />

   <!-- Capture status and quick actions -->
   <Border DockPanel.Dock="Bottom" Margin="0,10,0,0" Padding="12,10" CornerRadius="8"
           Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource SubtleLineBrush}" BorderThickness="1">
    <StackPanel>
     <StackPanel Orientation="Horizontal">
      <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,1,8,0">
       <Ellipse.Style>
        <Style TargetType="Ellipse">
         <Setter Property="Fill" Value="{DynamicResource MutedBrush}" />
         <Style.Triggers>
          <DataTrigger Binding="{Binding IsCaptureRunning}" Value="True"><Setter Property="Fill" Value="{DynamicResource GoodBrush}" /></DataTrigger>
         </Style.Triggers>
        </Style>
       </Ellipse.Style>
      </Ellipse>
      <TextBlock Text="{Binding ConnectionSummary}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
     </StackPanel>
     <Grid Margin="0,10,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <Button Command="{Binding ToggleCaptureCommand}" ToolTip="{Binding CaptureToggleToolTip}" Padding="8,0" HorizontalAlignment="Stretch">
       <StackPanel Orientation="Horizontal">
        <TextBlock FontFamily="{StaticResource IconFontFamily}" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0">
         <TextBlock.Style>
          <Style TargetType="TextBlock">
           <Setter Property="Text" Value="&#xE768;" />
           <Style.Triggers>
            <DataTrigger Binding="{Binding IsCaptureRunning}" Value="True"><Setter Property="Text" Value="&#xE71A;" /></DataTrigger>
           </Style.Triggers>
          </Style>
         </TextBlock.Style>
        </TextBlock>
        <TextBlock Text="{Binding CaptureToggleButtonText}" VerticalAlignment="Center" />
       </StackPanel>
      </Button>
      <Button Grid.Column="1" Command="{Binding ToggleThemeCommand}" Margin="6,0,0,0" AutomationProperties.Name="테마 전환">
       <Button.Style>
        <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
         <Setter Property="Content" Value="&#xE708;" />
         <Setter Property="ToolTip" Value="어두운 테마로 전환" />
         <Style.Triggers>
          <DataTrigger Binding="{Binding IsDarkMode}" Value="True">
           <Setter Property="Content" Value="&#xE706;" />
           <Setter Property="ToolTip" Value="밝은 테마로 전환" />
          </DataTrigger>
         </Style.Triggers>
        </Style>
       </Button.Style>
      </Button>
     </Grid>
    </StackPanel>
   </Border>

   <ListBox ItemsSource="{Binding NavigationView}" SelectedItem="{Binding SelectedDestination, Mode=TwoWay}" IsSynchronizedWithCurrentItem="False"
     MinWidth="0" Background="Transparent" BorderThickness="0" Padding="0"
     ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
     AutomationProperties.Name="주 메뉴">
    <ListBox.GroupStyle>
     <GroupStyle>
      <GroupStyle.HeaderTemplate>
       <DataTemplate><TextBlock Text="{Binding Name}" Style="{StaticResource EyebrowText}" Margin="10,12,0,4" /></DataTemplate>
      </GroupStyle.HeaderTemplate>
     </GroupStyle>
    </ListBox.GroupStyle>
    <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource NavigationItem}" /></ListBox.ItemContainerStyle>
    <ListBox.ItemTemplate>
     <DataTemplate>
      <StackPanel Orientation="Horizontal">
       <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFontFamily}" FontSize="16" Width="28" VerticalAlignment="Center" />
       <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
      </StackPanel>
     </DataTemplate>
    </ListBox.ItemTemplate>
   </ListBox>
  </DockPanel>
 </Border>
</UserControl>
