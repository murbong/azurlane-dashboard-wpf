<UserControl x:Class="AzurLaneDashboard.App.Views.FleetDamageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <DataTemplate x:Key="FormationSlotTemplate">
            <Border
                Background="{Binding Rarity, Converter={StaticResource RarityBrushConverter}, ConverterParameter=cell}"
                BorderBrush="{DynamicResource LineBrush}"
                BorderThickness="1"
                CornerRadius="6"
                MinHeight="58"
                Margin="0,0,8,8"
                Padding="8">
                <Grid>
                    <TextBlock Text="{Binding SlotText}"
                               Foreground="{DynamicResource MutedBrush}"
                               FontSize="11"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Top" />

                    <Grid Cursor="Hand"
                          Visibility="{Binding HasShip, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid.InputBindings>
                            <MouseBinding MouseAction="LeftClick"
                                          Command="{Binding DataContext.OpenShipDetailCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                          CommandParameter="{Binding Ship}" />
                        </Grid.InputBindings>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="42" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Image Source="{Binding ShipIconUrl, Converter={StaticResource AssetImageConverter}}"
                               Width="34"
                               Height="34"
                               Stretch="UniformToFill"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0" />

                        <StackPanel Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Margin="0,0,26,0">
                            <TextBlock Text="{Binding ShipName}"
                                       Style="{StaticResource ProposedShipNameText}" />
                            <TextBlock Text="{Binding ShipSummary}"
                                       Style="{StaticResource MutedText}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding ShipTimingText}"
                                       Style="{StaticResource MutedText}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="{Binding EmptyText}"
                               Foreground="{DynamicResource MutedBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibilityConverter}}" />
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="CooldownEquipmentCellTemplate">
            <Border Background="{Binding Rarity, Converter={StaticResource RarityBrushConverter}, ConverterParameter=cell}"
                    BorderBrush="{Binding Rarity, Converter={StaticResource RarityBrushConverter}, ConverterParameter=bar}"
                    BorderThickness="3,0,0,0"
                    CornerRadius="0"
                    Padding="8,6"
                    ToolTip="{Binding CooldownTooltip}">
                <ItemsControl ItemsSource="{Binding DisplayEquipmentTimings}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Height="32"
                                  Margin="0,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="98" />
                                </Grid.ColumnDefinitions>

                                <Border Width="28"
                                        Height="28"
                                        Background="{Binding EquipmentRarity, Converter={StaticResource RarityBrushConverter}, ConverterParameter=cell}"
                                        BorderBrush="{Binding EquipmentRarity, Converter={StaticResource RarityBrushConverter}, ConverterParameter=bar}"
                                        BorderThickness="1"
                                        CornerRadius="5"
                                        Padding="1"
                                        ToolTip="{Binding EquipmentTypeLabel}">
                                    <Image Source="{Binding EquipmentIconUrl, Converter={StaticResource AssetImageConverter}}"
                                           Stretch="Uniform" />
                                </Border>

                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="{Binding EquipmentName}"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding EnhanceText}"
                                               Foreground="{DynamicResource AccentBrush}"
                                               FontWeight="SemiBold"
                                               Margin="6,0,0,0" />
                                </StackPanel>

                                <Border Grid.Column="2"
                                         Style="{StaticResource AttributeChip}"
                                         MinWidth="88"
                                         HorizontalAlignment="Right"
                                         VerticalAlignment="Center"
                                         Margin="6,0,0,0">
                                    <TextBlock Text="{Binding ReloadPerShotText}"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center" />
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel>
        <TextBlock DockPanel.Dock="Top"
                   Text="{Binding FleetDamageUsageText}"
                   Foreground="{DynamicResource MutedBrush}"
                   Margin="0,0,0,8" />

        <Grid>
            <TextBlock Text="아직 편성을 불러오지 못했습니다. 데이터 수집 중에 게임의 편성 화면을 연 뒤 새로고침하세요."
                       Foreground="{DynamicResource MutedBrush}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasFleetCompositionGroups}" Value="False">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <TabControl ItemsSource="{Binding FleetCompositionGroups}"
                        SelectedItem="{Binding SelectedFleetCompositionGroup, Mode=TwoWay}">
                <TabControl.Style>
                    <Style TargetType="TabControl"
                           BasedOn="{StaticResource {x:Type TabControl}}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasFleetCompositionGroups}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TabControl.Style>
                <TabControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding FleetIcon}"
                                       Opacity="0.7"
                                       Margin="0,0,6,0" />
                            <TextBlock Text="{Binding FleetName}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DataTemplate>
                </TabControl.ItemTemplate>

                <TabControl.ContentTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                                       Text="{Binding Summary}"
                                       Foreground="{DynamicResource MutedBrush}"
                                       Margin="0,0,0,8" />

                            <ItemsControl Grid.Row="1"
                                          ItemsSource="{Binding FormationRows}"
                                          Margin="0,0,0,12">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="48" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding FormationName}"
                                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,8,8" />
                                            <ItemsControl Grid.Column="1"
                                                          ItemsSource="{Binding Slots}"
                                                          ItemTemplate="{StaticResource FormationSlotTemplate}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <UniformGrid Columns="3" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                            </ItemsControl>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <DataGrid Grid.Row="2"
                                      Style="{StaticResource MainListDataGrid}"
                                      ItemsSource="{Binding TimingRows}"
                                      RowHeight="118"
                                      MinHeight="260">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="위치"
                                                        Binding="{Binding FleetPositionText}"
                                                        Width="82" />
                                    <DataGridTemplateColumn Header="함선"
                                                             Width="1.6*"
                                                             CellStyle="{StaticResource FullHeightDataGridCell}"
                                                             CellTemplate="{StaticResource ShipIdentityCellTemplate}" />
                                    <DataGridTextColumn Header="장전"
                                                        Binding="{Binding ShipReloadText}"
                                                        Width="70" />
                                    <DataGridTemplateColumn Header="장비/쿨다운"
                                                            Width="4.2*"
                                                            CellStyle="{StaticResource FullHeightDataGridCell}"
                                                            CellTemplate="{StaticResource CooldownEquipmentCellTemplate}" />
                                    <DataGridTextColumn Header="비고"
                                                        Binding="{Binding Note}"
                                                        Width="1.6*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </DataTemplate>
                </TabControl.ContentTemplate>
            </TabControl>
        </Grid>
    </DockPanel>
</UserControl>
