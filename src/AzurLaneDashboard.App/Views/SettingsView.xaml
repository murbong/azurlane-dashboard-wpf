<UserControl x:Class="AzurLaneDashboard.App.Views.SettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- Small read-only status tile used for capture/update counters. -->
        <DataTemplate x:Key="StatusTileTemplate">
            <Border Style="{StaticResource InsetPanel}" Margin="0,0,8,8" Padding="12,8">
                <StackPanel>
                    <TextBlock Text="{Binding Label}" Style="{StaticResource CaptionText}" />
                    <TextBlock Text="{Binding Value}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" ToolTip="{Binding Value}" />
                </StackPanel>
            </Border>
        </DataTemplate>
        <Style x:Key="SectionHint" TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>
        <Style x:Key="SubHeading" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,4,0,10" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,6,8" MaxWidth="1100" HorizontalAlignment="Stretch">
            <!-- Data location -->
            <Expander Header="데이터 저장 위치" IsExpanded="True" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="대시보드가 읽고 쓰는 SQLite 데이터베이스입니다. 다른 DB를 열면 화면이 그 데이터로 바뀝니다." Style="{StaticResource SectionHint}" />
                    <TextBlock Text="SQLite 데이터베이스" Style="{StaticResource FieldLabel}" />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="DB 선택" Command="{Binding BrowseDatabaseCommand}" Margin="8,0,0,0" />
                        <TextBox Text="{Binding DatabasePath, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="SQLite 데이터베이스 경로" />
                    </DockPanel>
                </StackPanel>
            </Expander>

            <!-- Current data status -->
            <Expander Header="현재 데이터 상태" IsExpanded="False" Margin="0,0,0,10">
                <StackPanel>
                    <UniformGrid Columns="2">
                        <Border Style="{StaticResource InsetPanel}" Margin="0,0,8,8" Padding="12,8">
                            <StackPanel><TextBlock Text="소스" Style="{StaticResource CaptionText}" /><TextBlock Text="{Binding SnapshotSource}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" /></StackPanel>
                        </Border>
                        <Border Style="{StaticResource InsetPanel}" Margin="0,0,8,8" Padding="12,8">
                            <StackPanel><TextBlock Text="생성" Style="{StaticResource CaptionText}" /><TextBlock Text="{Binding GeneratedAt}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" /></StackPanel>
                        </Border>
                        <Border Style="{StaticResource InsetPanel}" Margin="0,0,8,8" Padding="12,8">
                            <StackPanel><TextBlock Text="마지막 로드" Style="{StaticResource CaptionText}" /><TextBlock Text="{Binding LastLoadedAt}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" /></StackPanel>
                        </Border>
                        <Border Style="{StaticResource InsetPanel}" Margin="0,0,8,8" Padding="12,8">
                            <StackPanel><TextBlock Text="DB 수정" Style="{StaticResource CaptionText}" /><TextBlock Text="{Binding DatabaseLastWriteAt}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" /></StackPanel>
                        </Border>
                    </UniformGrid>
                    <TextBlock Text="{Binding SnapshotWarning, StringFormat=경고: {0}}" Foreground="{DynamicResource WarnBrush}" TextWrapping="Wrap" Margin="0,4,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SnapshotWarning}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                    <DataTrigger Binding="{Binding SnapshotWarning}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Expander>

            <!-- Device connection -->
            <Expander Header="게임 및 기기 연결" IsExpanded="False" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="에뮬레이터·기기에서 데이터를 가져올 때 쓰는 경로입니다. 자동 탐색으로 대부분 채울 수 있습니다." Style="{StaticResource SectionHint}" />
                    <UniformGrid Columns="3">
                        <StackPanel Margin="0,0,12,12">
                            <TextBlock Text="지역" Style="{StaticResource FieldLabel}" />
                            <ComboBox SelectedValue="{Binding Region}" SelectedValuePath="Content" AutomationProperties.Name="지역">
                                <ComboBoxItem Content="KR" />
                                <ComboBoxItem Content="EN" />
                                <ComboBoxItem Content="JP" />
                                <ComboBoxItem Content="TW" />
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Margin="0,0,12,12">
                            <TextBlock Text="ADB 시리얼" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding Serial, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="ADB 시리얼" />
                        </StackPanel>
                        <StackPanel Margin="0,0,12,12">
                            <TextBlock Text="대함대 도크 보너스" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding GuildDockCapacityBonus}" AutomationProperties.Name="대함대 도크 보너스" />
                        </StackPanel>
                    </UniformGrid>
                    <UniformGrid Columns="2">
                        <StackPanel Margin="0,0,12,12">
                            <TextBlock Text="ADB 경로" Style="{StaticResource FieldLabel}" />
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="선택" Command="{Binding BrowseAdbPathCommand}" Margin="6,0,0,0" />
                                <TextBox Text="{Binding AdbPath, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="ADB 경로" />
                            </DockPanel>
                        </StackPanel>
                        <StackPanel Margin="0,0,12,12">
                            <TextBlock Text="MuMuManager 경로" Style="{StaticResource FieldLabel}" />
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="선택" Command="{Binding BrowseMuMuManagerPathCommand}" Margin="6,0,0,0" />
                                <TextBox Text="{Binding MuMuManagerPath, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="MuMuManager 경로" />
                            </DockPanel>
                        </StackPanel>
                    </UniformGrid>
                    <StackPanel Margin="0,0,12,12">
                        <TextBlock Text="데이터 저장 경로" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding DataDirectory, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="데이터 저장 경로" />
                    </StackPanel>
                    <Border Style="{StaticResource InsetPanel}" Margin="0,2,12,0">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Android 도구 자동 탐색" Command="{Binding AutoDetectAndroidToolsCommand}" Margin="12,0,0,0" />
                            <TextBlock Text="{Binding AndroidToolStatus}" Style="{StaticResource MutedText}" TextWrapping="Wrap" VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>
                </StackPanel>
            </Expander>

            <!-- Resource update -->
            <Expander Header="이름·이미지 업데이트" IsExpanded="False" Margin="0,0,0,10">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding UpdateStateLabel}" FontWeight="SemiBold" />
                            <TextBlock Text="게임 리소스와 메타데이터를 받아 함선·장비 이름과 아이콘을 갱신합니다." Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,2,12,0" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="{Binding UpdateButtonText}" Command="{Binding RunUpdateCommand}" Style="{StaticResource PrimaryButton}" VerticalAlignment="Center" />
                    </Grid>

                    <Border Style="{StaticResource InsetPanel}" Margin="0,12,0,0">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding UpdateProgressText}" Style="{StaticResource MutedText}" />
                                <TextBlock Text="{Binding UpdateProgressStage}" FontWeight="SemiBold" />
                            </DockPanel>
                            <TextBlock Text="{Binding UpdateProgressMessage}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,3,0,0" />
                            <ProgressBar Minimum="0" Maximum="100" Value="{Binding UpdateProgressValue, Mode=OneWay}" IsIndeterminate="{Binding UpdateProgressIsIndeterminate, Mode=OneWay}" Height="6" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>

                    <ItemsControl ItemsSource="{Binding UpdateStatusRows}" ItemTemplate="{StaticResource StatusTileTemplate}" Margin="0,12,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="4" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <TextBlock Text="경로" Style="{StaticResource SubHeading}" Margin="0,12,0,10" />
                    <UniformGrid Columns="2">
                        <StackPanel Margin="0,0,12,12">
                            <TextBlock Text="LuaScripts 경로" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding LuaRepoDirectory, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,12,12">
                            <TextBlock Text="브랜치" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding LuaBranch, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,12,12">
                            <TextBlock Text="맵 출력 경로" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding MapsDirectory, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,12,12">
                            <TextBlock Text="게임 리소스 경로" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding GameResourcesDirectory, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,12,12">
                            <TextBlock Text="정적 아이콘 경로" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding StaticAssetsDirectory, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,12,12">
                            <TextBlock Text="아이콘 manifest" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding LocalAssetManifest, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,12,12">
                            <TextBlock Text="업데이트 상태 파일" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding UpdateStatePath, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,12,12">
                            <TextBlock Text="진행 출력 간격" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding ProgressEvery}" />
                        </StackPanel>
                    </UniformGrid>

                    <StackPanel Margin="0,0,12,12">
                        <TextBlock Text="리소스 카테고리" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding CategoriesText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72" />
                    </StackPanel>

                    <TextBlock Text="옵션" Style="{StaticResource SubHeading}" />
                    <UniformGrid Columns="3">
                        <CheckBox Content="Git 갱신 건너뛰기" IsChecked="{Binding SkipGit}" Margin="0,0,16,10" />
                        <CheckBox Content="커뮤니티 추천 건너뛰기" IsChecked="{Binding SkipRegal}" Margin="0,0,16,10" />
                        <CheckBox Content="MuMu 리소스 건너뛰기" IsChecked="{Binding SkipGameResources}" Margin="0,0,16,10" />
                        <CheckBox Content="MuMu 없으면 실패" IsChecked="{Binding RequireGameResources}" Margin="0,0,16,10" />
                        <CheckBox Content="메타데이터만" IsChecked="{Binding MetadataOnly}" Margin="0,0,16,10" />
                        <CheckBox Content="scripts32/64 제외" IsChecked="{Binding SkipScripts}" Margin="0,0,16,10" />
                        <CheckBox Content="리소스 강제 pull" IsChecked="{Binding ForceGameResources}" Margin="0,0,16,10" />
                        <CheckBox Content="아이콘 추출 건너뛰기" IsChecked="{Binding SkipIconExtract}" Margin="0,0,16,10" />
                        <CheckBox Content="아이콘 강제 재추출" IsChecked="{Binding ForceIconExtract}" Margin="0,0,16,10" />
                    </UniformGrid>
                </StackPanel>
            </Expander>

            <!-- Live capture -->
            <Expander Header="실시간 데이터 수집" IsExpanded="False" Margin="0,0,0,10">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding CaptureStatusDetail}" Style="{StaticResource MutedText}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="{Binding CaptureStartButtonText}" Command="{Binding StartCaptureCommand}" Style="{StaticResource PrimaryButton}" />
                            <Button Content="{Binding CaptureStopButtonText}" Command="{Binding StopCaptureCommand}" Margin="8,0,0,0" />
                        </StackPanel>
                    </Grid>

                    <ItemsControl ItemsSource="{Binding CaptureStatusRows}" ItemTemplate="{StaticResource StatusTileTemplate}" Margin="0,12,0,4">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="5" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <!-- One capture per emulator; each writes to the account logged in on it. -->
                    <TextBlock Text="에뮬레이터" Style="{StaticResource SubHeading}" Margin="0,8,0,4" />
                    <TextBlock Style="{StaticResource SectionHint}" Margin="0,0,0,8"
                               Text="에뮬레이터마다 따로 캡처하고, 그 에뮬레이터에 로그인한 계정의 DB에 나눠 저장합니다. 캡처를 켠 뒤 게임에 로그인하면 바로 구분합니다. 이미 로그인한 채로 켜면 출격·편성·장비 교체 때 함선으로 계정을 확인할 때까지 기록을 미룹니다." />
                    <Border Style="{StaticResource InsetPanel}" Padding="0" Margin="0,0,0,10">
                        <ItemsControl ItemsSource="{Binding CaptureTargets}" AutomationProperties.Name="캡처할 에뮬레이터">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource SubtleLineBrush}" BorderThickness="0,0,0,1" Padding="12,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="170" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Ellipse x:Name="Dot" Width="8" Height="8" Margin="0,0,10,0" VerticalAlignment="Center" Fill="{DynamicResource MutedBrush}" />
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                                <TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Label}" />
                                                <TextBlock Text="{Binding StateText}" Style="{StaticResource CaptionText}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,12,0">
                                                <TextBlock x:Name="Account" Text="{Binding AccountText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding AccountText}" />
                                                <TextBlock Text="{Binding DetailText}" Style="{StaticResource CaptionText}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Content="{Binding ToggleText}" Command="{Binding ToggleCommand}" MinWidth="64"
                                                        AutomationProperties.Name="{Binding Label, StringFormat={}{0} 캡처 시작 또는 중지}" />
                                                <Button x:Name="Remove" Command="{Binding RemoveCommand}" Style="{StaticResource IconButton}" Content="&#xE711;"
                                                        Margin="6,0,0,0" ToolTip="목록에서 빼기"
                                                        AutomationProperties.Name="{Binding Label, StringFormat={}{0} 목록에서 빼기}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Kind}" Value="good"><Setter TargetName="Dot" Property="Fill" Value="{DynamicResource GoodBrush}" /></DataTrigger>
                                        <DataTrigger Binding="{Binding Kind}" Value="warn"><Setter TargetName="Dot" Property="Fill" Value="{DynamicResource WarnBrush}" /></DataTrigger>
                                        <DataTrigger Binding="{Binding Kind}" Value="bad"><Setter TargetName="Dot" Property="Fill" Value="{DynamicResource DangerBrush}" /></DataTrigger>
                                        <DataTrigger Binding="{Binding IsAdb}" Value="False"><Setter TargetName="Remove" Property="Visibility" Value="Collapsed" /></DataTrigger>
                                        <DataTrigger Binding="{Binding IsRunning}" Value="False"><Setter TargetName="Account" Property="Foreground" Value="{DynamicResource MutedBrush}" /></DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                    <StackPanel Visibility="{Binding IsAdbCaptureBackend, Converter={StaticResource BoolToVisibilityConverter}}" Margin="0,0,0,14">
                        <TextBlock Text="에뮬레이터 추가 (ADB 시리얼)" Style="{StaticResource FieldLabel}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MaxWidth="320" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding NewCaptureSerial, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="추가할 ADB 시리얼"
                                     ToolTip="예: emulator-5556, 127.0.0.1:16416" />
                            <Button Grid.Column="1" Content="추가" Command="{Binding AddCaptureSerialCommand}" Margin="6,0,0,0" />
                            <Button Grid.Column="2" Content="{Binding FindAdbDevicesButtonText}" Command="{Binding FindAdbDevicesCommand}" Style="{StaticResource QuietButton}" Margin="6,0,0,0"
                                    ToolTip="adb에 연결된 에뮬레이터 찾기" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding AvailableAdbSerials}" Margin="0,6,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.AddCaptureSerialCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" Style="{StaticResource QuietButton}" Margin="0,0,6,6"
                                            AutomationProperties.Name="{Binding StringFormat={}{0} 추가}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE710;" Style="{StaticResource IconText}" FontSize="11" Margin="0,0,6,0" />
                                            <TextBlock Text="{Binding}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding CaptureTargetsStatus}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,2,0,0" />
                    </StackPanel>

                    <UniformGrid Columns="3">
                        <StackPanel Margin="0,0,12,12">
                            <TextBlock Text="캡처 방식" Style="{StaticResource FieldLabel}" />
                            <ComboBox ItemsSource="{Binding CaptureBackendOptions}" SelectedItem="{Binding CaptureBackend}" AutomationProperties.Name="캡처 방식" />
                        </StackPanel>
                        <StackPanel Margin="0,0,12,12">
                            <TextBlock Text="서버 포트" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding CaptureServerPort}" AutomationProperties.Name="서버 포트" />
                        </StackPanel>
                        <StackPanel Margin="0,0,12,12">
                            <TextBlock Text="상태 출력 간격" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding CaptureStatusInterval}" AutomationProperties.Name="상태 출력 간격" />
                        </StackPanel>
                    </UniformGrid>
                    <UniformGrid Columns="2">
                        <StackPanel Margin="0,0,12,12">
                            <TextBlock Text="캡처 인터페이스" Style="{StaticResource FieldLabel}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox ItemsSource="{Binding CaptureInterfaceOptions}" SelectedValue="{Binding CaptureInterface, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Id" DisplayMemberPath="DisplayName" AutomationProperties.Name="캡처 인터페이스" />
                                <Button Grid.Column="1" Content="{Binding RefreshCaptureInterfacesButtonText}" Command="{Binding RefreshCaptureInterfacesCommand}" Margin="6,0,0,0" />
                            </Grid>
                            <TextBlock Text="{Binding CaptureInterfaceStatus}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Margin="0,0,12,12">
                            <TextBlock Text="서버 호스트 필터" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding CaptureServerHost, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="서버 호스트 필터" />
                        </StackPanel>
                    </UniformGrid>
                    <StackPanel Margin="0,0,12,12">
                        <TextBlock Text="dumpcap 경로" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding CaptureDumpcapPath, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="dumpcap 경로" />
                    </StackPanel>
                    <CheckBox Content="캡처 상세 로그" IsChecked="{Binding CaptureVerbose}" HorizontalAlignment="Left" />
                    <CheckBox Content="매크로용 상태 파일 쓰기" IsChecked="{Binding IsLiveStateExportEnabled}"
                              HorizontalAlignment="Left" Margin="0,10,0,0"
                              AutomationProperties.Name="매크로용 상태 파일 쓰기" />
                    <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="24,2,0,0">
                        <Run Text="ALAuto 매크로의 game 조건이 읽는 파일입니다. 마지막 전투, 진입한 해역, 쫄작 함대 상태를 담습니다." />
                        <LineBreak />
                        <Run Text="{Binding LiveStatePathText, Mode=OneWay}" />
                    </TextBlock>
                    <CheckBox Content="연속 작전이 끝나면 Windows 알림" IsChecked="{Binding NotifySortieEnd}"
                              HorizontalAlignment="Left" Margin="0,10,0,0"
                              AutomationProperties.Name="연속 작전이 끝나면 Windows 알림" />
                    <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="24,2,0,0"
                               Text="캡처 중에 패킷으로 판단합니다. 두 번 넘게 이어서 출격한 뒤 해역을 나와 1분 동안 다음 출격이 없으면 끝난 것으로, 해역 안에서 5분 동안 진행이 없으면 멈춘 것으로 봅니다. 매크로가 돌리는 출격은 매크로 알림만 띄웁니다." />
                </StackPanel>
            </Expander>

            <!-- Logs -->
            <Expander Header="수집·업데이트 로그" IsExpanded="False" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <DockPanel Margin="0,0,6,0" LastChildFill="True">
                        <TextBlock DockPanel.Dock="Top" Text="{Binding CaptureLogCountText, StringFormat=실시간 캡처 로그 · {0}}" Style="{StaticResource SubHeading}" Margin="0,0,0,8" />
                        <ListBox ItemsSource="{Binding CaptureLogLines}" MaxHeight="260" MinWidth="0" Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource SubtleLineBrush}" Padding="4">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayText}" FontFamily="Cascadia Mono, Consolas" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>

                    <DockPanel Grid.Column="1" Margin="6,0,0,0" LastChildFill="True">
                        <TextBlock DockPanel.Dock="Top" Text="{Binding UpdateLogCountText, StringFormat=업데이트 로그 · {0}}" Style="{StaticResource SubHeading}" Margin="0,0,0,8" />
                        <ListBox ItemsSource="{Binding UpdateLogLines}" MaxHeight="260" MinWidth="0" Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource SubtleLineBrush}" Padding="4">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayText}" FontFamily="Cascadia Mono, Consolas" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Grid>
            </Expander>

            <!-- Maintenance -->
            <Expander Header="고급 · 데이터베이스 정리" IsExpanded="False" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding DatabaseMaintenanceText}" Style="{StaticResource MutedText}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,16,0" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="{Binding DatabaseMaintenanceButtonText}" Command="{Binding CompactDatabaseCommand}" />
                        <Button Content="{Binding DeepDatabaseMaintenanceButtonText}" Margin="8,0,0,0" Command="{Binding DeepCompactDatabaseCommand}" />
                    </StackPanel>
                </Grid>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</UserControl>
