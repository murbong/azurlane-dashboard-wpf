<UserControl x:Class="AzurLaneDashboard.App.Views.DashboardShellView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:views="clr-namespace:AzurLaneDashboard.App.Views"
 Foreground="{DynamicResource TextBrush}"
 FontSize="13">
 <Grid Background="{DynamicResource BgBrush}">
  <Grid.ColumnDefinitions><ColumnDefinition Width="216" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
  <views:SidebarView />
  <Grid Grid.Column="1">
   <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
   <Grid Margin="24,18,24,12">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
    <views:TopToolbarView x:Name="Toolbar" />
    <Border Grid.Row="1" Background="{DynamicResource AccentSubtleBrush}" CornerRadius="8" Padding="14,10" Margin="0,0,0,12"
            Visibility="{Binding ShowNoSearchResults, Converter={StaticResource BoolToVisibilityConverter}}">
     <DockPanel>
      <Button DockPanel.Dock="Right" Content="필터 초기화" Command="{Binding ResetFiltersCommand}" Margin="12,0,0,0" />
      <TextBlock DockPanel.Dock="Left" Text="&#xE946;" Style="{StaticResource IconText}" Foreground="{DynamicResource AccentBrush}" Margin="0,0,10,0" />
      <StackPanel VerticalAlignment="Center">
       <TextBlock Text="조건에 맞는 함선이 없습니다" FontWeight="SemiBold" />
       <TextBlock Text="검색어를 줄이거나 필터를 초기화해 보세요." Style="{StaticResource MutedText}" Margin="0,2,0,0" />
      </StackPanel>
     </DockPanel>
    </Border>
    <TabControl Grid.Row="2" SelectedIndex="{Binding SelectedMainTabIndex, Mode=TwoWay}" Style="{StaticResource PageHost}">
     <TabItem><views:OverviewView /></TabItem>
     <TabItem><views:LevelingView /></TabItem>
     <TabItem><views:EquipmentView /></TabItem>
     <TabItem><views:FleetDamageView /></TabItem>
     <TabItem><views:SkillsView /></TabItem>
     <TabItem><views:SystemsView /></TabItem>
     <TabItem><views:DockView /></TabItem>
     <TabItem><views:AuctionView /></TabItem>
     <TabItem><views:PacketsView /></TabItem>
     <TabItem><views:SettingsView /></TabItem>
     <TabItem><views:FleetPlannerView DataContext="{Binding FleetPlanner}" /></TabItem>
     <TabItem><views:MacroView DataContext="{Binding Macros}" /></TabItem>
     <TabItem><views:MonthlyShopView DataContext="{Binding MonthlyShop}" /></TabItem>
     <TabItem><views:MeowfficerView DataContext="{Binding Meowfficers}" /></TabItem>
    </TabControl>
   </Grid>

   <!-- Status bar -->
   <Border Grid.Row="1" BorderBrush="{DynamicResource SubtleLineBrush}" BorderThickness="0,1,0,0" Background="{DynamicResource ShellBrush}">
    <StackPanel>
     <ProgressBar IsIndeterminate="True" Height="2" Visibility="{Binding IsReloading, Converter={StaticResource BoolToVisibilityConverter}}" />
     <DockPanel Margin="24,6,24,6" MinHeight="22">
      <CheckBox DockPanel.Dock="Right" Content="자동 갱신" IsChecked="{Binding IsAutoRefreshEnabled}" Margin="12,0,0,0" FontSize="12"
                ToolTip="데이터베이스가 바뀌면 자동으로 다시 읽습니다" />
      <TextBlock Text="{Binding Status}" TextTrimming="CharacterEllipsis" FontSize="12" Foreground="{DynamicResource MutedBrush}" ToolTip="{Binding Status}" VerticalAlignment="Center" />
     </DockPanel>
     <TextBlock Text="{Binding SettingsSaveError}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" FontSize="12" Margin="24,0,24,6" AutomationProperties.LiveSetting="Polite">
      <TextBlock.Style>
       <Style TargetType="TextBlock">
        <Style.Triggers>
         <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed" /></Trigger>
         <Trigger Property="Text" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></Trigger>
        </Style.Triggers>
       </Style>
      </TextBlock.Style>
     </TextBlock>
    </StackPanel>
   </Border>
  </Grid>
 </Grid>
</UserControl>
