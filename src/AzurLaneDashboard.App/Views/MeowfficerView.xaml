<UserControl x:Class="AzurLaneDashboard.App.Views.MeowfficerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="{DynamicResource TextBrush}"
             FontSize="13"
             SizeChanged="OnSizeChanged">
    <!-- 지휘냥. DataContext is the MeowfficerViewModel. -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="FleetPlannerShared.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Status and result chips: the colour follows the kind, the word always says it. -->
            <Style x:Key="KindChip" TargetType="Border" BasedOn="{StaticResource PlannerChip}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding StatusKind}" Value="good">
                        <Setter Property="Background" Value="{DynamicResource GoodSubtleBrush}" />
                        <Setter Property="TextElement.Foreground" Value="{DynamicResource GoodBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding StatusKind}" Value="warn">
                        <Setter Property="Background" Value="{DynamicResource WarnSubtleBrush}" />
                        <Setter Property="TextElement.Foreground" Value="{DynamicResource WarnBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding StatusKind}" Value="info">
                        <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
                        <Setter Property="TextElement.Foreground" Value="{DynamicResource AccentBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding StatusKind}" Value="muted">
                        <Setter Property="TextElement.Foreground" Value="{DynamicResource MutedBrush}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="CopyChip" TargetType="Border" BasedOn="{StaticResource PlannerChip}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding ChipKind}" Value="good">
                        <Setter Property="Background" Value="{DynamicResource GoodSubtleBrush}" />
                        <Setter Property="TextElement.Foreground" Value="{DynamicResource GoodBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding ChipKind}" Value="warn">
                        <Setter Property="Background" Value="{DynamicResource WarnSubtleBrush}" />
                        <Setter Property="TextElement.Foreground" Value="{DynamicResource WarnBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding ChipKind}" Value="muted">
                        <Setter Property="TextElement.Foreground" Value="{DynamicResource MutedBrush}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- A talent: wanted for the cat's fleet in accent (core) or plain (filler); unwanted struck through. -->
            <DataTemplate x:Key="TalentChipTemplate">
                <Border x:Name="Chip" CornerRadius="4" Padding="6,0" Margin="0,0,4,4" BorderThickness="1"
                        BorderBrush="{DynamicResource SubtleLineBrush}" ToolTip="{Binding ToolTipText}">
                    <TextBlock x:Name="Label" Text="{Binding Name}" FontSize="11" Foreground="{DynamicResource MutedBrush}" />
                </Border>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding Kind}" Value="core">
                        <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                        <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource AccentBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Kind}" Value="filler">
                        <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Kind}" Value="fixed">
                        <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Kind}" Value="off">
                        <Setter TargetName="Label" Property="TextDecorations" Value="Strikethrough" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>

            <DataTemplate x:Key="SlotTemplate">
                <Border BorderBrush="{DynamicResource SubtleLineBrush}" BorderThickness="0,1,0,0" Padding="0,8,0,6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="{Binding Slot}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource MutedBrush}"
                                   VerticalAlignment="Center" />
                        <DockPanel Grid.Column="1" VerticalAlignment="Center">
                            <Border DockPanel.Dock="Left" Style="{StaticResource Portrait}" Width="24" Height="24" Margin="0,0,8,0"
                                    BorderThickness="0,0,0,2"
                                    Visibility="{Binding HasCurrent, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Image Source="{Binding Current.IconUrl, Converter={StaticResource AssetImageConverter}}" Stretch="UniformToFill"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                            </Border>
                            <TextBlock Text="{Binding CurrentText}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" ToolTip="{Binding CurrentText}" />
                        </DockPanel>
                        <Border Grid.Column="2" Style="{StaticResource KindChip}" Margin="8,0,0,0">
                            <TextBlock Text="{Binding Status}" />
                        </Border>
                        <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" FontSize="12" TextWrapping="Wrap" Margin="0,3,0,0"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   Visibility="{Binding HasCandidates, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Run Text="{Binding CandidateText, Mode=OneWay}" />
                            <Run Text="{Binding CandidateSummary, StringFormat=— {0}, Mode=OneWay}" Foreground="{DynamicResource MutedBrush}" />
                        </TextBlock>
                        <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding Note}" FontSize="11" TextWrapping="Wrap"
                                   Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,0"
                                   Visibility="{Binding HasNote, Converter={StaticResource BoolToVisibilityConverter}}" />
                    </Grid>
                </Border>
            </DataTemplate>

            <DataTemplate x:Key="FleetTemplate">
                <Border Style="{StaticResource SectionPanel}" Padding="14,12,14,6" Margin="0,0,12,12" Width="372">
                    <StackPanel>
                        <TextBlock>
                            <Run Text="{Binding Title, Mode=OneWay}" FontSize="14" FontWeight="Bold" />
                            <Run Text="{Binding TypeText, Mode=OneWay}" FontSize="12" Foreground="{DynamicResource MutedBrush}" />
                        </TextBlock>
                        <TextBlock Text="{Binding HullText}" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,8" />
                        <ItemsControl ItemsSource="{Binding Slots}" ItemTemplate="{StaticResource SlotTemplate}" Focusable="False" />
                    </StackPanel>
                </Border>
            </DataTemplate>

            <!-- One owned cat; choosing it opens its talent card. -->
            <DataTemplate x:Key="CopyTemplate">
                <Button Cursor="Hand" FocusVisualStyle="{x:Null}" HorizontalContentAlignment="Stretch"
                        AutomationProperties.Name="{Binding DisplayName, StringFormat={}{0} 재능 보기}"
                        Command="{Binding DataContext.SelectCatCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Face" Padding="14,7" Background="Transparent" BorderBrush="{DynamicResource SubtleLineBrush}"
                                    BorderThickness="0,1,0,0">
                                <ContentPresenter />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Face" Property="Background" Value="{DynamicResource ControlHoverBrush}" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Face" Property="Background" Value="{DynamicResource ControlHoverBrush}" />
                                </Trigger>
                                <DataTrigger Value="True">
                                    <DataTrigger.Binding>
                                        <MultiBinding Converter="{StaticResource StringEqualsConverter}">
                                            <Binding Path="Uid" />
                                            <Binding Path="DataContext.SelectedUid" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                        </MultiBinding>
                                    </DataTrigger.Binding>
                                    <Setter TargetName="Face" Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
                                </DataTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="92" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding LevelText}" FontWeight="Bold" />
                            <TextBlock Text="{Binding SubText}" FontSize="11" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <ItemsControl Grid.Column="1" ItemsSource="{Binding Talents}" ItemTemplate="{StaticResource TalentChipTemplate}"
                                      VerticalAlignment="Center" Margin="0,4,8,0" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <Border Style="{StaticResource CopyChip}" HorizontalAlignment="Right">
                                <TextBlock Text="{Binding ChipText}" />
                            </Border>
                            <TextBlock Text="{Binding AssignmentText}" FontSize="11" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Right"
                                       Margin="0,2,0,0" Visibility="{Binding HasAssignments, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </StackPanel>
                    </Grid>
                </Button>
            </DataTemplate>

            <DataTemplate x:Key="KindTemplate">
                <Border Style="{StaticResource SectionPanel}" Padding="0,0,0,2" Margin="0,0,0,10">
                    <StackPanel>
                        <!-- The kind's face (commandericon, from the data update) beside its name and role. -->
                        <DockPanel Margin="14,10,14,6">
                            <Border Style="{StaticResource Portrait}" Width="36" Height="36" Margin="0,0,10,0" VerticalAlignment="Center"
                                    BorderThickness="0,0,0,2">
                                <Image Source="{Binding IconUrl, Converter={StaticResource AssetImageConverter}}" Stretch="UniformToFill"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                            </Border>
                            <TextBlock TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                                <Run Text="{Binding Name, Mode=OneWay}" FontSize="14" FontWeight="Bold" />
                                <Run Text="{Binding Rarity, Mode=OneWay}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource RatingHighTextBrush}" />
                                <Run Text="{Binding RoleText, Mode=OneWay}" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
                            </TextBlock>
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding Copies}" ItemTemplate="{StaticResource CopyTemplate}" Focusable="False" />
                    </StackPanel>
                </Border>
            </DataTemplate>

            <DataTemplate x:Key="FilterTemplate">
                <Button Style="{StaticResource SegmentButton}" Content="{Binding Text}" Tag="{Binding IsSelected}" Margin="0,0,2,0"
                        Command="{Binding DataContext.SelectFilterCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding}" />
            </DataTemplate>

            <DataTemplate x:Key="TalentRowTemplate">
                <Border BorderBrush="{DynamicResource SubtleLineBrush}" BorderThickness="0,1,0,0" Padding="0,7" ToolTip="{Binding Description}">
                    <DockPanel>
                        <TextBlock x:Name="Kind" DockPanel.Dock="Right" Text="{Binding KindText}" FontSize="11" FontWeight="Bold"
                                   Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
                        <TextBlock TextTrimming="CharacterEllipsis">
                            <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" />
                            <Run Text="{Binding WorthText, Mode=OneWay}" FontSize="11" Foreground="{DynamicResource MutedBrush}" />
                        </TextBlock>
                    </DockPanel>
                </Border>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding Kind}" Value="core">
                        <Setter TargetName="Kind" Property="Foreground" Value="{DynamicResource AccentBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Kind}" Value="filler">
                        <Setter TargetName="Kind" Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <StackPanel Margin="0,0,8,16">
            <!-- What the ratings rest on, and why there is no tier letter. -->
            <Border Style="{StaticResource SectionPanel}" Padding="16,12" Margin="0,0,0,18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="평가 기준" Style="{StaticResource FactLabel}" FontWeight="Bold" Margin="0,1,14,4" />
                    <TextBlock Grid.Column="1" Text="{Binding Dashboard.PrimarySourceText}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,4" />
                    <TextBlock Grid.Row="1" Text="보조" Style="{StaticResource FactLabel}" FontWeight="Bold" Margin="0,1,14,4" />
                    <TextBlock Grid.Row="1" Grid.Column="1" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,0,0,4">
                        <Run Text="{Binding Dashboard.SecondarySourceText, Mode=OneWay}" />
                        <Run Text="· 출처 간 의견이 다르면 함께 표시" />
                    </TextBlock>
                    <TextBlock Grid.Row="2" Text="등급표가 없는 이유" Style="{StaticResource FactLabel}" FontWeight="Bold" Margin="0,1,14,0" />
                    <TextBlock Grid.Row="2" Grid.Column="1" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"
                               Text="냥별 S/A/B 티어표는 공신력 있는 곳이 없습니다. 출처가 실제로 평가하는 '어느 함대·칸에 맞는지'와 '재능 우선순위'로 판단합니다." />
                </Grid>
            </Border>

            <TextBlock Margin="0,0,0,10" TextTrimming="CharacterEllipsis">
                <Run Text="함대 배치 점검" FontSize="16" FontWeight="Bold" />
                <Run Text="출격 함대의 함종으로 함대 종류를 정함 · 지휘 = 1번 칸, 참모 = 2번 칸" FontSize="12" Foreground="{DynamicResource MutedBrush}" />
            </TextBlock>
            <ItemsControl ItemsSource="{Binding Dashboard.Fleets}" ItemTemplate="{StaticResource FleetTemplate}" Focusable="False" Margin="0,0,0,12"
                          Visibility="{Binding HasFleets, Converter={StaticResource BoolToVisibilityConverter}}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>

            <Border Style="{StaticResource SectionPanel}" Visibility="{Binding HasNoCats, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}"
                           Text="아직 지휘냥 정보가 없습니다. 캡처를 켠 채 게임에 로그인하면 보유 지휘냥 목록이 들어옵니다." />
            </Border>

            <StackPanel Visibility="{Binding HasCats, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock Margin="0,6,0,10">
                    <Run Text="보유 지휘냥" FontSize="16" FontWeight="Bold" />
                    <Run Text="{Binding CountText, Mode=OneWay}" FontSize="12" Foreground="{DynamicResource MutedBrush}" />
                </TextBlock>
                <Border Style="{StaticResource SegmentFrame}" HorizontalAlignment="Left">
                    <ItemsControl ItemsSource="{Binding Filters}" ItemTemplate="{StaticResource FilterTemplate}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </Border>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,10">
                    <TextBlock Text="재능 칩:" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <Border CornerRadius="4" Padding="6,0" Margin="0,0,4,0" BorderThickness="1" BorderBrush="{DynamicResource AccentBrush}">
                        <TextBlock Text="핵심" FontSize="11" Foreground="{DynamicResource AccentBrush}" />
                    </Border>
                    <Border CornerRadius="4" Padding="6,0" Margin="0,0,4,0" BorderThickness="1" BorderBrush="{DynamicResource SubtleLineBrush}">
                        <TextBlock Text="보조" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" />
                    </Border>
                    <Border CornerRadius="4" Padding="6,0" Margin="0,0,8,0" BorderThickness="1" BorderBrush="{DynamicResource SubtleLineBrush}">
                        <TextBlock Text="이 냥의 함대에선 안 씀" FontSize="11" Foreground="{DynamicResource MutedBrush}" TextDecorations="Strikethrough" />
                    </Border>
                    <TextBlock Text="출처가 그 냥의 함대에 꼽은 우선순위 기준" FontSize="11" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
                </StackPanel>

                <Grid x:Name="Body">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="ListColumn" Width="3*" />
                        <ColumnDefinition x:Name="GapColumn" Width="20" />
                        <ColumnDefinition x:Name="SideColumn" Width="2*" MinWidth="340" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ItemsControl x:Name="ListSection" ItemsSource="{Binding VisibleKinds}" ItemTemplate="{StaticResource KindTemplate}" Focusable="False" />

                    <!-- The chosen cat's talents against its fleet's priorities, and what to train next. -->
                    <Border x:Name="SideSection" Grid.Column="2" Style="{StaticResource SectionPanel}" Padding="16,14" VerticalAlignment="Top"
                            DataContext="{Binding SelectedCat}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,10">
                                <Border DockPanel.Dock="Left" Style="{StaticResource Portrait}" Width="52" Height="52" Margin="0,0,12,0"
                                        VerticalAlignment="Top" BorderThickness="0,0,0,2">
                                    <Image Source="{Binding IconUrl, Converter={StaticResource AssetImageConverter}}" Stretch="UniformToFill"
                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DisplayName}" FontSize="16" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock FontSize="12" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,2,0,0">
                                        <Run Text="{Binding Rarity, Mode=OneWay}" />
                                        <Run Text="·" />
                                        <Run Text="{Binding LevelText, Mode=OneWay}" />
                                        <Run Text="·" />
                                        <Run Text="{Binding SkillText, Mode=OneWay}" />
                                        <Run Text="{Binding AssignmentText, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                            </DockPanel>
                            <WrapPanel>
                                <StackPanel Margin="0,0,24,6">
                                    <TextBlock Text="출처 역할" Style="{StaticResource FactLabel}" />
                                    <TextBlock Text="{Binding RoleText}" Style="{StaticResource FactValue}" />
                                </StackPanel>
                                <StackPanel Margin="0,0,24,6">
                                    <TextBlock Text="재능 점수" Style="{StaticResource FactLabel}" />
                                    <TextBlock Text="{Binding ScoreText}" Style="{StaticResource FactValue}" />
                                </StackPanel>
                                <StackPanel Margin="0,0,0,6">
                                    <TextBlock Text="시작 재능" Style="{StaticResource FactLabel}" />
                                    <TextBlock Text="{Binding VerdictText}" Style="{StaticResource FactValue}" />
                                </StackPanel>
                            </WrapPanel>
                            <TextBlock Text="{Binding RoleSummary}" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,2,0,8" />
                            <TextBlock FontSize="12" Foreground="{DynamicResource WarnBrush}" TextWrapping="Wrap" Margin="0,0,0,8"
                                       Visibility="{Binding HasDisputed, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Run Text="출처 간 이견:" FontWeight="Bold" />
                                <Run Text="{Binding Disputed, Mode=OneWay}" />
                            </TextBlock>
                            <ItemsControl ItemsSource="{Binding Talents}" ItemTemplate="{StaticResource TalentRowTemplate}" Focusable="False" />
                            <Border Style="{StaticResource HintPanel}" Visibility="{Binding HasNextTalent, Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock TextWrapping="Wrap">
                                        <Run Text="다음 재능" FontWeight="Bold" />
                                        <Run Text="{Binding NextTalent, Mode=OneWay}" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                                    </TextBlock>
                                    <TextBlock FontSize="11" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,3,0,0"
                                               Visibility="{Binding HasReplaceTalent, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <Run Text="재능 칸 5개가 차 있어 바꿀 칸:" />
                                        <Run Text="{Binding ReplaceTalent, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock Text="훈련에서 고를 수 있는 재능은 무작위로 뜹니다." FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource HintPanel}" Visibility="{Binding Fixed, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="템페스타 냥은 재능을 다시 뽑을 수 없어 출처도 냥 전체로만 평가합니다." FontSize="12"
                                           Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>

                <TextBlock FontSize="11" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0"
                           Text="재능 점수 = 출처가 그 냥의 함대에 꼽은 재능(핵심·보조)의 포인트 합 · 최대 SSR 10 / SR 8 / R 7. 시작 재능 판정은 처음 붙은 재능으로 출처 기준표를 적용합니다. 다 키운 냥은 재능 점수를, 덜 키운 냥은 시작 재능 판정을 보여 줍니다." />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
