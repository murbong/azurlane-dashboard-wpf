<UserControl x:Class="AzurLaneDashboard.App.Views.MonthlyShopView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 보급 상점 › 월간 상점 (코어 월간) in the order worth buying. DataContext is the MonthlyShopDashboard. -->
    <UserControl.Resources>
        <CollectionViewSource x:Key="ShopRows" Source="{Binding Rows}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="TierText" />
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>

        <Style x:Key="TierChip" TargetType="Border">
            <Setter Property="MinHeight" Value="22" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="CornerRadius" Value="11" />
            <Setter Property="Background" Value="{DynamicResource Surface2Brush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Resources>
                <Style TargetType="TextBlock">
                    <Setter Property="FontSize" Value="12" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </Style>
            </Style.Resources>
            <Style.Triggers>
                <DataTrigger Binding="{Binding TierKind}" Value="need">
                    <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding TierKind}" Value="suggest">
                    <Setter Property="Background" Value="{DynamicResource GoodSubtleBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource GoodBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BudgetStatus" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding BudgetKind}" Value="good">
                    <Setter Property="Foreground" Value="{DynamicResource GoodBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding BudgetKind}" Value="short">
                    <Setter Property="Foreground" Value="{DynamicResource WarnBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- The month, how far the core data on hand goes, and what the order is based on. -->
        <Border Style="{StaticResource SectionPanel}" Padding="16,12" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock TextWrapping="Wrap">
                        <Run Text="{Binding MonthText, Mode=OneWay}" FontWeight="Bold" FontSize="15" />
                        <Run Text="  " />
                        <Run Text="{Binding RecordText, Mode=OneWay}" FontSize="12" Foreground="{DynamicResource MutedBrush}" />
                    </TextBlock>
                    <TextBlock Text="{Binding BudgetText}" FontSize="13" FontWeight="SemiBold" Margin="0,6,0,0"
                               TextWrapping="Wrap" />
                    <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,6,0,0"
                               Text="순서: 추천 편성이 더 좋아지는 장비 → 쩔 대기열 각성 재료 → 처음 얻는 함선(함대 기술 포인트순) → 장비 상자. 원형·훈장 상점은 아직 순위에 넣지 않았습니다." />
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="24,0,0,0">
                    <TextBlock Text="보유 코어 데이터" Style="{StaticResource MutedText}" HorizontalAlignment="Right" />
                    <TextBlock Text="{Binding BalanceValueText}" FontSize="24" FontWeight="SemiBold"
                               HorizontalAlignment="Right" Margin="0,2,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <DataGrid Grid.Row="1" x:Name="ShopGrid"
                  Style="{StaticResource MainListDataGrid}"
                  ItemsSource="{Binding Source={StaticResource ShopRows}}"
                  IsSynchronizedWithCurrentItem="False"
                  SizeChanged="ShopGrid_SizeChanged"
                  CanUserSortColumns="False"
                  IsReadOnly="True"
                  RowHeight="52"
                  VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                  VirtualizingPanel.ScrollUnit="Pixel"
                  AutomationProperties.Name="월간 상점 구매 순위"
                  Visibility="{Binding HasRows, Converter={StaticResource BoolToVisibilityConverter}}">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsDimmed}" Value="True">
                            <Setter Property="Opacity" Value="0.62" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.GroupStyle>
                <GroupStyle>
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource InputBrush}" Padding="14,6"
                                    BorderBrush="{DynamicResource SubtleLineBrush}" BorderThickness="0,1,0,0">
                                <TextBlock FontSize="11">
                                    <Run Text="{Binding Name, Mode=OneWay}" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}" />
                                    <Run Text="{Binding Items[0].TierNote, Mode=OneWay}" Foreground="{DynamicResource MutedBrush}" />
                                    <Run Text="{Binding ItemCount, Mode=OneWay, StringFormat=· {0:N0}개}" Foreground="{DynamicResource MutedBrush}" />
                                </TextBlock>
                            </Border>
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </DataGrid.GroupStyle>
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="#" Width="46" MinWidth="46">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Rank}" FontWeight="SemiBold" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="품목" Width="220" MinWidth="220" CellStyle="{StaticResource FullHeightDataGridCell}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid VerticalAlignment="Center" Margin="0,0,8,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <!-- The good's icon on its rarity frame, as the shop shows it. -->
                                <Border Width="38" Height="38" Margin="8,0,10,0" CornerRadius="6" Padding="2" BorderThickness="1"
                                        Background="{Binding Rarity, Converter={StaticResource RarityBrushConverter}, ConverterParameter=cell}"
                                        BorderBrush="{Binding Rarity, Converter={StaticResource RarityBrushConverter}, ConverterParameter=bar}">
                                    <Image Source="{Binding IconUrl, Converter={StaticResource AssetImageConverter}}" Stretch="Uniform"
                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Name}" />
                                    <TextBlock Text="{Binding KindText}" FontSize="12" Foreground="{DynamicResource MutedBrush}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="판정" Width="110" MinWidth="110">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource TierChip}">
                                <TextBlock Text="{Binding TierText}" />
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn x:Name="ReasonColumn" Header="이유" Width="300" MinWidth="180">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Reason}" FontSize="12" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                       MaxHeight="34" ToolTip="{Binding Reason}" Foreground="{DynamicResource SecondaryTextBrush}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="가격" Width="96" MinWidth="96">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel HorizontalAlignment="Right" Margin="0,0,6,0">
                                <TextBlock Text="{Binding PriceText}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                <TextBlock Text="{Binding CumulativeText}" FontSize="11" Foreground="{DynamicResource MutedBrush}"
                                           HorizontalAlignment="Right"
                                           Visibility="{Binding IsBuy, Converter={StaticResource BoolToVisibilityConverter}}" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="지금 코어로" Width="96" MinWidth="96">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding BudgetStatusText}" Style="{StaticResource BudgetStatus}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="구매 / 한도" Width="84" MinWidth="84">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding StockText}" HorizontalAlignment="Right" Margin="0,0,10,0"
                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="1" Style="{StaticResource SectionPanel}"
                Visibility="{Binding HasNoRows, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,40">
                <TextBlock Text="이번 달 코어 월간 목록이 없습니다" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock Text="설정에서 게임 데이터를 업데이트하면 이번 달 상품 목록을 받아 순서를 매깁니다."
                           Style="{StaticResource MutedText}" Margin="0,4,0,0" HorizontalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
